#!/bin/bash
shopt -qs extglob

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: [DEBUG[ENABLED]_SINK=FILE|&N|"" | DEBUG_LOGDIR=DIR] %q %s\n' "$(basename "$1")" '[-I|--invert-match] [--for DEBUGGEE] [-x|--extension EXTENSION] [-m|--module MODULE] [--to FILE] [-d|--description DESCRIPTION] [--get-sink] [--] [IGNORED-ARG ...] [-?|-h|--help]'
    echo
    printf 'Usage: [ -n "$DEBUG" ] && debugSink="$(%q %s)" && SCRIPT-FUNCTION > $debugSink\n' "$(basename "$1")" '... --get-sink'
    printf 'Usage: ! ${DEBUG:+%q %s} ${DEBUG:-:} || NDEBUG-COMMAND\n' "$(basename "$1")" '--invert-match ... --'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Check whether debugging is enabled for the caller.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --invert-match|-I	Succeed if debugging is NOT enabled for the caller.
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --extension|-x EXTENSION
			The EXTENSION (e.g. a sigil like "!" or a directive like
			"+=SUFFIX" that modify the debugging behavior) needs to
			be active for the check to succeed.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
    --to FILE		Use FILE instead of the default debug file DEBUGGEE.log
    --description|-d DESCRIPTION
			Use DESCRIPTION instead of "activate" for the debug
			enablement information.
    --get-sink		Print the sink filespec where debug output is written
			to.
SEE ALSO:
- debugcustom can directly execute COMMAND(s) if debugging is enabled for the
  caller, and will log them. Prefer if COMMAND(s) can be invoked by an external
  script; use debugenabled only if the COMMAND(s) are script-local.
- debugeval can also execute script-local COMMAND(s) (through eval) and
  additionally allows replacing and embellishing the COMMAND(s) to be executed.

EXIT STATUS:
    0	Debugging is enabled for the caller.
    1	Debugging is not enabled for the caller.
HELPTEXT
}

debuggee="$DEBUG_DEBUGGEE"
extension=
enabledStatus=0
disabledStatus=1
module=
unset toFile
description=
action=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--invert-match|-I)
			shift; enabledStatus=1; disabledStatus=0;;
	--for)		shift; debuggee="${1?}"; shift;;
	--extension|-x)	shift; extension="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--to)		shift; toFile="${1:?}"; shift;;
	--description|-d) shift; description="${1?}"; shift;;
	--get-sink)	shift; action=printSink;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done

[ -n "$DEBUG" ] || exit $disabledStatus

unset sink
setSink()
{
    [ -n "${sink+t}" ] && return 0

    sink="${DEBUGENABLED_SINK-$DEBUG_SINK}" # Note: Don't consider --to FILE here.
    case "$sink" in
	'')		[ -n "$BATS_TEST_NAME" ] \
			    && exec >&3 \
			    || exec >&2
			;;
	\&+([0-9]))	eval "exec >$sink";;
	?*)		exec >>"$sink";;
    esac
}

printSink()
{
    sink="${toFile-${DEBUGENABLED_SINK-$DEBUG_SINK}}"
    case "$sink" in
	'')		sink=/dev/stderr;;
	\&+([0-9]))	sink="/dev/fd/${sink#\&}";;
	?*)		;;
    esac
    printf '%s\n' "$sink"
}

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
if [ -z "$debuggee" ]; then
    {
	IFS= read -r -d '' debugCmd
	IFS= read -r -d '' debugSecond
    } < /proc/${PPID}/cmdline
    debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
fi

case ",${DEBUG}," in
    *,"${debuggee}${module:+:}${module}${extension}",*)
	case ",${DEBUG}," in
	    *,@(debug|${scriptName})=*,*) DEBUGENABLED_SINK=",${DEBUG},"; DEBUGENABLED_SINK="${DEBUGENABLED_SINK#*,@(debug|${scriptName})=}"; DEBUGENABLED_SINK="${DEBUGENABLED_SINK%%,*}"
		;;
	    *)	defaultLogDirspec="${DEBUG_LOGDIR-$PWD}"
		: ${DEBUG_SINK="${defaultLogDirspec}${defaultLogDirspec:+/}${debuggee//:/-}.log"}
		;;
	esac

	$action
	exit $enabledStatus
	;;
    *,@(debug|${scriptName}),*)
	setSink
	printf '%s: Will %s with DEBUG=%q\n' "$scriptName" "${description:-activate}" "${debuggee}${module:+:}${module}${extension}"
	;;
esac
exit $disabledStatus
