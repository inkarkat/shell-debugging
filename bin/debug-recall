#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Open the last debug log used by withDebug in the pager.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

DATA_DIRSPEC="${XDG_DATA_HOME:-${HOME}/.local/share}"
WITHDEBUG_LASTLOG_FILESPEC="${DATA_DIRSPEC}/withDebug-last-log"
lastDebugLogFilespec=; [ -r "$WITHDEBUG_LASTLOG_FILESPEC" ] \
    && <"$WITHDEBUG_LASTLOG_FILESPEC" IFS=$'\n' read -r lastDebugLogFilespec \
    && [ -r "$lastDebugLogFilespec" ] \
    || exit 1

typeset -a pager=("${PAGER:-less}" --RAW-CONTROL-CHARS); [ -t 1 ] || pager=(cat)
exec "${pager[@]}" "$lastDebugLogFilespec"
