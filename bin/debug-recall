#!/bin/bash

: ${DEBUG_LOGDIR="${XDG_RUNTIME_DIR:-/tmp}/debug"}

debugRecall()
{
    FILERECALL="$(basename -- "$0")" \
    FILERECALL_BASEDIR="$DEBUG_LOGDIR" \
    FILERECALL_WHERE='debug log' \
    FILERECALL_OFFER_SUBDIRS='' \
	exec file-recall "$@"
}

LONGUSAGE=
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    $LONGUSAGE cat <<HELPTEXT
Open the last debug log used by withDebug in the pager.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-?|-h|--help]'
    $LONGUSAGE echo
    $LONGUSAGE cat <<HELPTEXT
Open all debug log files used by withDebug (last modified first) in the pager.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '-a|--all'
    $LONGUSAGE echo
    debugRecall --help
}
printShortUsage()
{
    LONGUSAGE=: printLongUsage "$1"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}

typeset -a pager=("${PAGER:-less}" --RAW-CONTROL-CHARS); [ -t 1 ] || pager=(cat)
action=
case "$1" in
    --help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
    --all|-a)		shift; action=pageAll;;
esac

pageAll()
{
    readarray -t filespecsByCreation < <(ls -1 --sort=time "$DEBUG_LOGDIR"/*)
    if [ ${#filespecsByCreation[@]} -eq 0 ]; then
	echo >&2 'ERROR: No debug log files found.'
	exit 1
    fi

    exec "${pager[@]}" -- "${filespecsByCreation[@]}"
}

if [ -z "$action" -a $# -eq 0 ]; then
    DATA_DIRSPEC="${XDG_DATA_HOME:-${HOME}/.local/share}"
    WITHDEBUG_LASTLOG_FILESPEC="${DATA_DIRSPEC}/withDebug-last-log"
    lastDebugLogFilespec=; [ -r "$WITHDEBUG_LASTLOG_FILESPEC" ] \
	&& <"$WITHDEBUG_LASTLOG_FILESPEC" IFS=$'\n' read -r lastDebugLogFilespec \
	&& [ -r "$lastDebugLogFilespec" ] \
	|| exit 1

    exec "${pager[@]}" "$lastDebugLogFilespec"
else
    if [ ! -d "$DEBUG_LOGDIR" ]; then
	echo >&2 'ERROR: No debug log directory found.'
	exit 5
    fi

    ${action:-debugRecall} "$@"
fi
