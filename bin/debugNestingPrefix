#!/bin/bash

: ${DEBUGNESTINGPREFIX_BASE:=2}
: ${PS4:='+ '}

baseLevel=$((DEBUGNESTINGPREFIX_BASE + DEBUGNESTINGPREFIX_OFFSET))
nestingPrefix=
if [ $SHLVL -gt $baseLevel ]; then
    nestingLevel=$((SHLVL - baseLevel))
else
    # When a client command is directly invoked from an (interactive) terminal,
    # SHLVL is 2, but we still want to show a single nesting prefix.
    nestingLevel=1
fi

nesting="${PS4:0:1}"
printf -v nestingPrefix "%${nestingLevel}s" "$nesting"
printf %s%s "${nestingPrefix// /$nesting}" "${PS4:1}"
