#!/bin/bash

: ${VERBOSE_IFS=' '}
[ "$VERBOSE_IFS" = newline ] && VERBOSE_IFS=$' \\\n  '

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [VERBOSE_IFS=STRING|newline] [VERBOSE_TRACEFILE=FILESPEC|&N] %q %s\n' "$(basename "$1")" '[--eval] [--] [SIMPLECOMMAND ...] [-?|-h|--help]'
    echo
    printf 'Usage: [VERBOSE_IFS=STRING|newline] [VERBOSE_TRACEFILE=FILESPEC|&N] ${DEBUG:+%q %s} %s\n' "$(basename "$1")" '-D|--on-debug KEYWORD' '[...] [--] [SIMPLECOMMAND ...]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Execute and write arguments (separated by a space or \$VERBOSE_IFS) as an
execution trace (i.e. with \$PS4 prepended and indicating the nesting level) to
standard error / \$VERBOSE_TRACEFILE, just like "set -x".
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --on-debug|-D KEYWORD
			Only print the execution trace when \$DEBUG contains
			KEYWORD. Else, the COMMAND is just executed as if
			verbose weren't prepended.
    --eval		Print the evaluation result instead of the (quoted)
			eval.
HELPTEXT
}

printer()
{
    PRETTYPRINTQUOTEDARGS_IFS="$VERBOSE_IFS" \
	PRETTYPRINTQUOTEDARGS_PREFIX="$tracePrefix" \
	prettyPrintQuotedArgs -- "$@" >&3
}
executor()
{
    [ "$1" = eval ] && EXEC=''
    $EXEC "$@"
}

EXEC=exec
isActive=t
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--on-debug|-D)	shift; case ",${DEBUG:-}," in *,${1:?},*) ;; *) isActive=;; esac; shift;;
	--eval)		shift
			if [ "$1" = eval ]; then
			    shift
			    printer()
			    {
				joinBy >&3 --prefix "${tracePrefix}" -- "$VERBOSE_IFS" "$@"
			    }
			    executor()
			    {
				eval "$@"
			    }
			fi
			;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
[ $# -eq 0 ] && exit

if [ "$isActive" ]; then
    case "$VERBOSE_TRACEFILE" in
	'')		exec 3>&2;;
	\&[0-9])	eval "exec 3>$VERBOSE_TRACEFILE";;
	?*)		exec 3>>"$VERBOSE_TRACEFILE";;
    esac

    # Duplicated to ../../shell-basics/bin/echotrace
    nestingPrefix=
    if [ $SHLVL -gt 3 ]; then
	nesting="${PS4:0:1}"
	printf -v nestingPrefix "%$((SHLVL - 3))s" "$nesting"; printf -v nestingPrefix %s "${nestingPrefix// /$nesting}"
    fi
    tracePrefix="${nestingPrefix}${PS4:-\$ }"

    VERBOSE_IFS="${VERBOSE_IFS//$'\n'/$'\n'${tracePrefix}}"

    printer "$@"
fi

executor "$@"
