#!/bin/bash
shopt -qs extglob

: ${VERBOSE_IFS=' '}
[ "$VERBOSE_IFS" = newline ] && VERBOSE_IFS=$' \\\n  '

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"

getShortUsage()
{
    local usageSep
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local hadTopic=
	case "$1" in
	    ''|general) printf %s "${usageSep}${hadTopic:+ }" ''; hadTopic=t;;&
	    ''|eval) printf %s "${usageSep}${hadTopic:+ }" '[--eval]'; hadTopic=t;;&
	    ''|io)
		printf %s "${usageSep}${hadTopic:+ }" '[-0|--stdin] [-1|--stdout] [-2|--stderr]'; hadTopic=t;;&
	    ''|debug)
		[ -n "$1" ] \
		    && local format='%s%s' \
		    || local format='%s[%s]'
		printf "$format" "${usageSep}${hadTopic:+ }" '-D|--on-debug [--for DEBUGGEE] [-m|--module MODULE]'; hadTopic=t;;&
	    ''|debug-io)
		printf %s "${usageSep}${hadTopic:+ }" '[--io-modules | [--stdin-module MODULE] [--stdout-module MODULE] [--stderr-module MODULE]]'; hadTopic=t;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2; };;
	esac
	shift; usageSep=' '
    done
}
getLongUsage()
{
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local topic="$1"; shift
	local hadTopic=
	case "$topic" in
	    ''|general)
		hadTopic=t
		;;&
	    ''|eval)
		cat <<HELPTEXT
    --eval		Print the evaluation result instead of the (quoted)
			eval.
HELPTEXT
		hadTopic=t
		;;&
	    ''|io)
		cat <<HELPTEXT
    --stdin|-0		Print standard input (prefixed by 0: if more than one
			input-output option is active).
    --stdout|-1		Print standard output (prefixed by 1: if more than one
			input-output option is active). Without debugging, this
			only makes sense in combination with -2|--stderr, to see
			what output came from where.
    --stderr|-2		Print standard error output (prefixed by 2: if more than
			one input-output option is active). Without debugging,
			this only makes sense in combination with -1|--stdout,
			to see what output came from where.
HELPTEXT
		hadTopic=t
		;;&
	    ''|debug)
		cat <<HELPTEXT
    --on-debug|-D	Log the execution trace to a debug file (DEBUGGEE.log)
			only when \$DEBUG refers to the DEBUGGEE, and print the
			debug filespec to the terminal.
			Else, the COMMAND is just executed as if verbose weren't
			prepended.
$ DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
$ DEBUG=debug|${scriptName}=FILE,DEBUGGEE[:MODULE] DEBUGGEE ... will log to a custom
  FILE instead.
$ DEBUG=debug|${scriptName} DEBUGGEE ... will show for what DEBUGGEE it will enable
  (if not actually enabled).
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
HELPTEXT
		hadTopic=t
		;;&
	    ''|debug-io)
		cat <<HELPTEXT
    --io-modules	Activate standard input / output / error logging only if
			debugging for module "input" / "output" / "errors" of
			the DEBUGGEE is enabled.
			Syntactic sugar for --stdin-module input \\
			    --stdout-module output --stderr-module errors
    --stdin-module MODULE
			Log standard input (prefixed by 0: if more than one
			input-output option is active) only if debugging for
			MODULE of the DEBUGGEE is enabled.
    --stdout-module MODULE
			Log standard output (prefixed by 1: if more than one
			input-output option is active) only if debugging for
			MODULE of the DEBUGGEE is enabled.
    --stderr-module MODULE
			Log standard error output (prefixed by 2: if more than
			one input-output option is active) only if debugging for
			MODULE of the DEBUGGEE is enabled.
HELPTEXT
		hadTopic=t
		;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
	esac
    done
}
printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [VERBOSE_IFS=STRING|newline] [VERBOSE_SINK=FILESPEC|&N|""] %q %s\n' "$(basename "$1")" "$(getShortUsage general eval io) [-?|-h|--help] ..."
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '... [--] COMMAND [ARG ...]'
    echo
    printf 'Usage: ${DEBUG:+[env VERBOSE_IFS=STRING|newline] [[VERBOSE|DEBUG]_SINK=FILESPEC|&N|""] %q %s} %s\n' "$(basename "$1")" "... $(getShortUsage general debug debug-io) [--]" 'COMMAND [ARG ...]'
    printf 'Usage: ${DEBUG:+%q %s} %s\n' "$(basename "$1")" "... $(getShortUsage general debug) $(getShortUsage debug-io) --eval [--]" 'eval COMMAND [ARG ...]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Execute and write arguments (separated by a space or \$VERBOSE_IFS) as an
execution trace (i.e. with \$PS4 prepended and indicating the nesting level) to
standard error / \$VERBOSE_SINK / \$DEBUG_SINK, just like "set -x".
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage ''
    cat <<HELPTEXT
SEE ALSO:
- dump-args-exec also prints command-line arguments (without nesting level), and
  can prepend an argument count or use array syntax, but is more geared toward
  data, not commands.
- dump-status --verbose additionally prints the exit status of the COMMAND.
- debugtee can be injected into a pipeline to log what's passing through, so
  it's like verbose --stdin or --stdout, but not associated with a command.

EXIT STATUS:
    2	Bad invocation, wrong or missing command-line arguments.
    *	Any exit status from COMMAND(s).
HELPTEXT
}

EXEC=exec
isEval=
typeset -a logFileDescriptors=()
stdinModule=
stdinModuleEnabler=
stdoutModule=
stdoutModuleEnabler=
stderrModule=
stderrModuleEnabler=
isActive=t
isOnDebug=
debuggee="$DEBUG_DEBUGGEE"
module=
option() { :; }
parameter() { :; }
parameterToSep() { :; }
argCount() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			parameterToSep() { argCount "$@"; }
			argCount() { local argCount="${1:?}"; shift; isUnderstandSubtopic "$@" || exit 1; printf $argCount; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--stdin|-0)	shift; logFileDescriptors[0]+=t; option io;;
	--stdout|-1)	shift; logFileDescriptors[1]+=t; option io;;
	--stderr|-2)	shift; logFileDescriptors[2]+=t; option io;;
	--on-debug|-D)	shift; isOnDebug=t; isActive=; option debug;;
	--for)		shift; debuggee="${1?}"; shift; option debug;;
	--module|-m)	shift; module="${1:?}"; shift; option debug;;
	--io-modules)	shift
			stdinModule='input'; stdinModuleEnabler+=t
			stdoutModule='output'; stdoutModuleEnabler+=t
			stderrModule='errors'; stderrModuleEnabler+=t
			option debug-io
			;;
	--stdin-module)	shift; stdinModule="${1:?}"; shift; stdinModuleEnabler+=t; parameter debug-io;;
	--stdout-module) shift; stdoutModule="${1:?}"; shift; stdoutModuleEnabler+=t; parameter debug-io;;
	--stderr-module) shift; stderrModule="${1:?}"; shift; stderrModuleEnabler+=t; parameter debug-io;;
	--eval)		shift; isEval=t; option eval;;
	--)		endOfOptionsAndParameters; shift; break;;
	-*)		noUnderstand; { echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		endOfOptionsAndParameters; break;;
    esac
done
if [ $# -eq 0 ]; then
    echo >&2 'ERROR: No COMMAND passed.'
    echo >&2
    printUsage "$0" >&2
    exit 2
fi
if [ "$isOnDebug" ]; then
    [ -n "$stdinModule" ] && unset 'logFileDescriptors[0]'
    [ -n "$stdoutModule" ] && unset 'logFileDescriptors[1]'
    [ -n "$stderrModule" ] && unset 'logFileDescriptors[2]'
fi

printer()
{
    PRETTYPRINTQUOTEDARGS_IFS="$VERBOSE_IFS" \
    PRETTYPRINTQUOTEDARGS_PREFIX="$printerPrefix" \
	prettyPrintQuotedArgs -- "$@" >&3
}
executor()
{
    [ "$1" = eval ] && EXEC=''
    $EXEC "$@"
}
if [ "$isEval" ] && [ "$1" = eval ]; then
    shift
    printer()
    {
	joinBy >&3 --prefix "${printerPrefix}" -- "$VERBOSE_IFS" "$@"
    }
    executor()
    {
	eval "$@"
    }
fi

logWithPrefix()
{
    local prefix="${1?}"; shift
    local isEOL=t
    while IFS=$'\n' read -r line || { isEOL=; [ -n "$line" ]; }
    do
	printf '%s%s\n' "$prefix" "$line" >&3
	printf "%s%s${isEOL:+\\n}" "$line"
    done
}

executeAndCapture0()
{
    logWithPrefix "$stdinPrefix" \
	| executor "$@"
}

executeAndCapture1()
{
    executor "$@" \
	| logWithPrefix "$stdoutPrefix"
}

executeAndCapture2()
{
    {
	executor "$@" 4>&1 1>&2 2>&4 4>&- \
	    | logWithPrefix "$stderrPrefix"
    } 4>&1 1>&2 2>&4 4>&-
}

executeAndCapture01()
{
    logWithPrefix "$stdinPrefix" \
	| executor "$@" \
	| logWithPrefix "$stdoutPrefix"
}

executeAndCapture02()
{
    logWithPrefix "$stdinPrefix" \
	| \
	    {
		executor "$@" 4>&1 1>&2 2>&4 4>&- \
		    | logWithPrefix "$stderrPrefix"
	    } 4>&1 1>&2 2>&4 4>&-
}

executeAndCapture12()
{
    {
	executor "$@" 4>&1 1>&2 2>&4 4>&- \
	    | logWithPrefix "$stderrPrefix"
    } 4>&1 1>&2 2>&4 4>&- \
	| logWithPrefix "$stdoutPrefix"
}

executeAndCapture012()
{
    logWithPrefix "$stdinPrefix" \
	| \
	    {
		executor "$@" 4>&1 1>&2 2>&4 4>&- \
	|	logWithPrefix "$stderrPrefix"
	    } 4>&1 1>&2 2>&4 4>&- \
	| logWithPrefix "$stdoutPrefix"
}

unset timestampPrefix
setSinkDefaults()
{
    [ -n "${timestampPrefix+t}" ] && return 0

    case ",${DEBUG}," in
	*,@(debug|${scriptName})=*,*)
	    VERBOSE_SINK=",${DEBUG},"; VERBOSE_SINK="${VERBOSE_SINK#*,@(debug|${scriptName})=}"; VERBOSE_SINK="${VERBOSE_SINK%%,*}"
	    ;;
	*)  : ${DEBUG_SINK="${PWD}/${debuggee//:/-}.log"};;
    esac

    timestampPrefix="$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging})"
}

unset sink
setSink()
{
    [ -n "${sink+t}" ] && return 0

    setSinkDefaults
    sink="${VERBOSE_SINK-${isOnDebug:+$DEBUG_SINK}}"
    case "$sink" in
	'')		exec 3>&2;;
	\&+([0-9]))	eval "exec 3>$sink";;
	?*)		exec 3>>"$sink";;
    esac
}

printfToSink()
{
    setSink
    printf >&3 "$@"
}

timestampPrefix=
if [ "$isOnDebug" ] && [ -n "$DEBUG" ]; then
    if [ -z "$debuggee" ]; then
	{
	    IFS= read -r -d '' debugCmd
	    IFS= read -r -d '' debugSecond
	} < /proc/${DUMPARGS_PPID:-$PPID}/cmdline
	debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
    fi

    case ",${DEBUG}," in
	*,${debuggee}${module:+:}${module},*)
	    setSinkDefaults
	    isActive=t
	    EXEC=''
	    ;;
	*,@(debug|${scriptName}),*)
	    logFileDescriptorWhat=; logFileDescriptorWhat="${!logFileDescriptors[*]}"
	    printfToSink '%s: Will log command%s with DEBUG=%q\n' "$scriptName" "${logFileDescriptorWhat:+ and file descriptor(s) }${logFileDescriptorWhat}" "${debuggee}${module:+:}${module}"
	    ;;
    esac

    [ -n "$stdinModule" ] \
	&& case ",${DEBUG}," in
	    *,${debuggee}:${stdinModule},*)
		logFileDescriptors[0]+=$stdinModuleEnabler
		setSinkDefaults
		;;
	    *,@(debug|${scriptName}),*)
		printfToSink '%s: Will log stdin with DEBUG=%q\n' "$scriptName" "${debuggee}:${stdinModule}"
		;&
	    *)	unset 'logFileDescriptors[0]';;
	esac

    [ -n "$stdoutModule" ] \
	&& case ",${DEBUG}," in
	    *,${debuggee}:${stdoutModule},*)
		logFileDescriptors[1]+=$stdoutModuleEnabler
		setSinkDefaults
		;;
	    *,@(debug|${scriptName}),*)
		printfToSink '%s: Will log stdout with DEBUG=%q\n' "$scriptName" "${debuggee}:${stdoutModule}"
		;&
	    *)	unset 'logFileDescriptors[1]';;
	esac

    [ -n "$stderrModule" ] \
	&& case ",${DEBUG}," in
	    *,${debuggee}:${stderrModule},*)
		logFileDescriptors[2]+=$stderrModuleEnabler
		setSinkDefaults
		;;
	    *,@(debug|${scriptName}),*)
		printfToSink '%s: Will log stderr with DEBUG=%q\n' "$scriptName" "${debuggee}:${stderrModule}"
		;&
	    *)	unset 'logFileDescriptors[2]';;
	esac
fi

if [ "$isActive" -o ${#logFileDescriptors[@]} -gt 0 ]; then
    setSink

    nestingPrefix="$(debugNestingPrefix)"
    VERBOSE_IFS="${VERBOSE_IFS//$'\n'/$'\n'${nestingPrefix}}"
    printerPrefix="${timestampPrefix}${timestampPrefix:+ }${nestingPrefix}"

    [ "$isActive" ] && printer "$@"
fi

stdinPrefix='0: '
stdoutPrefix='1: '
stderrPrefix='2: '
logFileDescriptorCount="${logFileDescriptors[*]}"; logFileDescriptorCount="${logFileDescriptorCount// /}"
case ${#logFileDescriptorCount} in
    0)	launcher=executor;;
    1)	stdinPrefix=''; stdoutPrefix=''; stderrPrefix='';&
    *)	printf -v launcher '%d' "${!logFileDescriptors[@]}"; launcher="executeAndCapture${launcher}"
	EXEC=''
	;;
esac

$launcher "$@"
