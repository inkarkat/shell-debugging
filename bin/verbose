#!/bin/bash
shopt -qs extglob

: ${VERBOSE_IFS=' '}
[ "$VERBOSE_IFS" = newline ] && VERBOSE_IFS=$' \\\n  '

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [VERBOSE_IFS=STRING|newline] [VERBOSE_SINK=FILESPEC|&N] %q %s\n' "$(basename "$1")" '[--eval] [--] COMMAND [ARG ...] [-?|-h|--help]'
    echo
    printf 'Usage: [VERBOSE_IFS=STRING|newline] ${DEBUG:+%q %s} %s\n' "$(basename "$1")" '[--eval] -D|--on-debug [--for DEBUGGEE] [-m|--module MODULE] [--]' 'COMMAND [ARG ...]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Execute and write arguments (separated by a space or \$VERBOSE_IFS) as an
execution trace (i.e. with \$PS4 prepended and indicating the nesting level) to
standard error / \$VERBOSE_SINK, just like "set -x".
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --eval		Print the evaluation result instead of the (quoted)
			eval.
    --on-debug|-D	Log the execution trace to a debug file (DEBUGGEE.log)
			only when \$DEBUG refers to the DEBUGGEE. Else, the
			COMMAND is just executed as if verbose weren't
			prepended.
$ DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
$ DEBUG=debug|${scriptName}=FILE,DEBUGGEE[:MODULE] DEBUGGEE ... will log to a custom
  FILE instead.
$ DEBUG=debug|${scriptName} DEBUGGEE ... will show for what DEBUGGEE it will enable (if not
  actually enabled).
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
EXIT STATUS:
    2	Bad invocation, wrong or missing command-line arguments.
    *	Any exit status from COMMAND(s).
HELPTEXT
}

printer()
{
    PRETTYPRINTQUOTEDARGS_IFS="$VERBOSE_IFS" \
	PRETTYPRINTQUOTEDARGS_PREFIX="$tracePrefix" \
	prettyPrintQuotedArgs -- "$@" >&3
}
executor()
{
    $EXEC "$@"
}

EXEC=exec
isActive=t
isOnDebug=
debuggee=
module=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--on-debug|-D)	shift; isOnDebug=t; isActive=;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--eval)		shift
			if [ "$1" = eval ]; then
			    shift
			    printer()
			    {
				joinBy >&3 --prefix "${tracePrefix}" -- "$VERBOSE_IFS" "$@"
			    }
			    executor()
			    {
				eval "$@"
			    }
			fi
			;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -eq 0 ]; then
    echo >&2 'ERROR: No COMMAND passed.'
    echo >&2
    printUsage "$0" >&2
    exit 2
fi

if [ "$isOnDebug" ] && [ -n "$DEBUG" ]; then
    if [ -z "$debuggee" ]; then
	{
	    IFS= read -r -d '' debugCmd
	    IFS= read -r -d '' debugSecond
	} < /proc/${DUMPARGS_PPID:-$PPID}/cmdline
	debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
    fi

    case ",${DEBUG:-}," in
	*,${debuggee}${module:+:}${module},*)
	    case ",${DEBUG:-}," in
		*,@(debug|${scriptName})=*,*)
		    VERBOSE_SINK=",${DEBUG},"; VERBOSE_SINK="${VERBOSE_SINK#*,@(debug|${scriptName})=}"; VERBOSE_SINK="${VERBOSE_SINK%%,*}"
		    ;;
		*)  : ${VERBOSE_SINK:="${PWD}/${debuggee//:/-}.log"};;
	    esac
	    isActive=t
	    EXEC=''
	    ;;
	*,@(debug|${scriptName}),*)
	    printf >&2 '%s: Will activate with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    ;;
    esac
fi

if [ "$isActive" ]; then
    case "$VERBOSE_SINK" in
	'')		exec 3>&2;;
	\&[0-9])	eval "exec 3>$VERBOSE_SINK";;
	?*)		exec 3>>"$VERBOSE_SINK";;
    esac

    # Duplicated to echotrace
    nestingPrefix=
    if [ $SHLVL -gt 3 ]; then
	nesting="${PS4:0:1}"
	printf -v nestingPrefix "%$((SHLVL - 3))s" "$nesting"; printf -v nestingPrefix %s "${nestingPrefix// /$nesting}"
    fi
    tracePrefix="${nestingPrefix}${PS4:-\$ }"

    VERBOSE_IFS="${VERBOSE_IFS//$'\n'/$'\n'${tracePrefix}}"

    printer "$@"
fi

executor "$@"; status=$?
if [ "$isOnDebug" ] && [ -n "$VERBOSE_SINK" ]; then
    printf >&2 "%s%s invocation logged to %q\\n" "$PS4" "$scriptName" "$VERBOSE_SINK"
fi
exit $status
