#!/bin/bash
shopt -qs extglob

: ${VERBOSE_IFS=' '}
[ "$VERBOSE_IFS" = newline ] && VERBOSE_IFS=$' \\\n  '

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [VERBOSE_IFS=STRING|newline] [[VERBOSE|DEBUG]_SINK=FILESPEC|&N] %q %s\n' "$(basename "$1")" '[--eval] [-0|--stdin] [-1|--stdout] [-2|--stderr] [-?|-h|--help] ...'
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '... [--] COMMAND [ARG ...]'
    echo
    printf 'Usage: ${DEBUG:+%q %s} %s\n' "$(basename "$1")" '... -D|--on-debug [--for DEBUGGEE] [-m|--module MODULE] [--]' 'COMMAND [ARG ...]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Execute and write arguments (separated by a space or \$VERBOSE_IFS) as an
execution trace (i.e. with \$PS4 prepended and indicating the nesting level) to
standard error / \$VERBOSE_SINK / \$DEBUG_SINK, just like "set -x".
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --eval		Print the evaluation result instead of the (quoted)
			eval.
    --stdin|-0		Print standard input (prefixed by 0: if more than one
			input-output option is active).
    --stdout|-1		Print standard output (prefixed by 1: if more than one
			input-output option is active). Without debugging, this
			only makes sense in combination with -2|--stderr, to see
			what output came from where.
    --stderr|-2		Print standard error output (prefixed by 2: if more than
			one input-output option is active). Without debugging,
			this only makes sense in combination with -1|--stdout,
			to see what output came from where.
    --on-debug|-D	Log the execution trace to a debug file (DEBUGGEE.log)
			only when \$DEBUG refers to the DEBUGGEE, and print the
			debug filespec to the terminal.
			Else, the COMMAND is just executed as if verbose weren't
			prepended.
$ DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
$ DEBUG=debug|${scriptName}=FILE,DEBUGGEE[:MODULE] DEBUGGEE ... will log to a custom
  FILE instead.
$ DEBUG=debug|${scriptName} DEBUGGEE ... will show for what DEBUGGEE it will enable
  (if not actually enabled).
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
SEE ALSO:
- dump-args-exec also prints command-line arguments (without nesting level), and
  can prepend an argument count or use array syntax, but is more geared toward
  data, not commands.
- dump-status --verbose additionally prints the exit status of the COMMAND.
- debugtee can be injected into a pipeline to log what's passing through, so
  it's like verbose --stdin or --stdout, but not associated with a command.

EXIT STATUS:
    2	Bad invocation, wrong or missing command-line arguments.
    *	Any exit status from COMMAND(s).
HELPTEXT
}

printer()
{
    PRETTYPRINTQUOTEDARGS_IFS="$VERBOSE_IFS" \
    PRETTYPRINTQUOTEDARGS_PREFIX="$nestingPrefix" \
	prettyPrintQuotedArgs -- "$@" >&3
}
executor()
{
    $EXEC "$@"
}

EXEC=exec
typeset -a logFileDescriptors=()
isActive=t
isOnDebug=
debuggee="$DEBUG_DEBUGGEE"
module=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--stdin|-0)	shift; logFileDescriptors[0]+=t;;
	--stdout|-1)	shift; logFileDescriptors[1]+=t;;
	--stderr|-2)	shift; logFileDescriptors[2]+=t;;
	--on-debug|-D)	shift; isOnDebug=t; isActive=;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--eval)		shift
			if [ "$1" = eval ]; then
			    shift
			    printer()
			    {
				joinBy >&3 --prefix "${nestingPrefix}" -- "$VERBOSE_IFS" "$@"
			    }
			    executor()
			    {
				eval "$@"
			    }
			fi
			;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -eq 0 ]; then
    echo >&2 'ERROR: No COMMAND passed.'
    echo >&2
    printUsage "$0" >&2
    exit 2
fi

stdinPrefix='0: '
stdoutPrefix='1: '
stderrPrefix='2: '
logFileDescriptorCount="${logFileDescriptors[*]}"; logFileDescriptorCount="${logFileDescriptorCount// /}"
case ${#logFileDescriptorCount} in
    0)	launcher=executor;;
    1)	stdinPrefix=''; stdoutPrefix=''; stderrPrefix='';&
    *)	printf -v launcher '%d' "${!logFileDescriptors[@]}"; launcher="executeAndCapture${launcher}"
	EXEC=''
	;;
esac

logWithPrefix()
{
    local prefix="${1?}"; shift
    local isEOL=t
    while IFS=$'\n' read -r line || { isEOL=; [ -n "$line" ]; }
    do
	printf '%s%s\n' "$prefix" "$line" >&3
	printf "%s%s${isEOL:+\\n}" "$line"
    done \
}

executeAndCapture0()
{
    logWithPrefix "$stdinPrefix" \
	| executor "$@"
}

executeAndCapture1()
{
    executor "$@" \
	| logWithPrefix "$stdoutPrefix"
}

executeAndCapture2()
{
    {
	executor "$@" 4>&1 1>&2 2>&4 4>&- \
	    | logWithPrefix "$stderrPrefix"
    } 4>&1 1>&2 2>&4 4>&-
}

executeAndCapture01()
{
    logWithPrefix "$stdinPrefix" \
	| executor "$@" \
	| logWithPrefix "$stdoutPrefix"
}

executeAndCapture02()
{
    logWithPrefix "$stdinPrefix" \
	| \
	    {
		executor "$@" 4>&1 1>&2 2>&4 4>&- \
		    | logWithPrefix "$stderrPrefix"
	    } 4>&1 1>&2 2>&4 4>&-
}

executeAndCapture12()
{
    {
	executor "$@" 4>&1 1>&2 2>&4 4>&- \
	    | logWithPrefix "$stderrPrefix"
    } 4>&1 1>&2 2>&4 4>&- \
	| logWithPrefix "$stdoutPrefix"
}

executeAndCapture012()
{
    logWithPrefix "$stdinPrefix" \
	| \
	    {
		executor "$@" 4>&1 1>&2 2>&4 4>&- \
	|	logWithPrefix "$stderrPrefix"
	    } 4>&1 1>&2 2>&4 4>&- \
	| logWithPrefix "$stdoutPrefix"
}

printfToTerm()
{
    { printf >/dev/tty "$@"; } 2>/dev/null
}

if [ "$isOnDebug" ] && [ -n "$DEBUG" ]; then
    if [ -z "$debuggee" ]; then
	{
	    IFS= read -r -d '' debugCmd
	    IFS= read -r -d '' debugSecond
	} < /proc/${DUMPARGS_PPID:-$PPID}/cmdline
	debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
    fi

    case ",${DEBUG:-}," in
	*,${debuggee}${module:+:}${module},*)
	    case ",${DEBUG:-}," in
		*,@(debug|${scriptName})=*,*)
		    VERBOSE_SINK=",${DEBUG},"; VERBOSE_SINK="${VERBOSE_SINK#*,@(debug|${scriptName})=}"; VERBOSE_SINK="${VERBOSE_SINK%%,*}"
		    ;;
		*)  : ${DEBUG_SINK:="${PWD}/${debuggee//:/-}.log"};;
	    esac
	    isActive=t
	    EXEC=''
	    ;;
	*,@(debug|${scriptName}),*)
	    printfToTerm '%s: Will activate with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    ;;
    esac
fi

sink="${VERBOSE_SINK:-${isOnDebug:+$DEBUG_SINK}}"
if [ "$isActive" ]; then
    case "$sink" in
	'')		exec 3>&2;;
	\&+([0-9]))	eval "exec 3>$sink";;
	?*)		exec 3>>"$sink";;
    esac

    nestingPrefix="$(debugNestingPrefix)"
    VERBOSE_IFS="${VERBOSE_IFS//$'\n'/$'\n'${nestingPrefix}}"

    printer "$@"
fi

$launcher "$@"; status=$?
if [ "$isOnDebug" ] && [ -n "$sink" ]; then
    printfToTerm "%s%s invocation logged to %q\\n" "$nestingPrefix" "$scriptName" "$sink"
fi
exit $status
