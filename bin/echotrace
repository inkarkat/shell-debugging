#!/bin/bash
shopt -qs extglob

: ${ECHOTRACE_IFS=' '}
[ "$ECHOTRACE_IFS" = newline ] && ECHOTRACE_IFS=$' \\\n  '

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"

getShortUsage()
{
    local usageSep
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local hadTopic=
	case "$1" in
	    #''|general) printf %s "${usageSep}${hadTopic:+ }" ''; hadTopic=t;;&
	    ''|eval) printf %s "${usageSep}${hadTopic:+ }" '[--eval]'; hadTopic=t;;&
	    ''|io)
		printf %s "${usageSep}${hadTopic:+ }" '[-0|--stdin]'; hadTopic=t;;&
	    ''|debug)
		[ -n "$1" ] \
		    && local format='%s%s' \
		    || local format='%s[%s]'
		printf "$format" "${usageSep}${hadTopic:+ }" '--for DEBUGGEE [-m|--module MODULE]'; hadTopic=t;;&
	    ''|debug-io)
		printf %s "${usageSep}${hadTopic:+ }" '[--io-modules | [--stdin-module MODULE]]'; hadTopic=t;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2; };;
	esac
	shift; usageSep=' '
    done
}
getLongUsage()
{
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local topic="$1"; shift
	local hadTopic=
	case "$topic" in
	    # ''|general)
	    #     hadTopic=t
	    #     ;;&
	    ''|eval)
		cat <<HELPTEXT
    --eval		Print the evaluation result instead of the (quoted)
			eval.
HELPTEXT
		hadTopic=t
		;;&
	    ''|debug)
		cat <<HELPTEXT
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
HELPTEXT
		hadTopic=t
		;;&
	    ''|io)
		cat <<HELPTEXT
    --stdin|-0		Log standard input (instead of swallowing it when
			activated).
HELPTEXT
		hadTopic=t
		;;&
	    ''|debug-io)
		cat <<HELPTEXT
    --io-modules	Activate standard input logging only if debugging for
			module "input" of the DEBUGGEE is enabled.
			Syntactic sugar for --stdin-module input
    --stdin-module MODULE
			Log standard input only if debugging for MODULE of the
			DEBUGGEE is enabled.
HELPTEXT
		hadTopic=t
		;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
	esac
    done
}
printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "$(getShortUsage debug io debug-io) [-?|-h|--help] ..."
    printf 'Usage: ${DEBUG:+[env ECHOTRACE_IFS=STRING|newline] [(ECHOTRACE|DEBUG)_SINK=FILESPEC|&N|""] %q %s} %s\n' "$(basename "$1")" '... [--]' 'COMMAND [...]'
    printf 'Usage: ${DEBUG:+%q %s} %s\n' "$(basename "$1")" '... --eval [--]' 'eval COMMAND [...]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
When \$DEBUG refers to the DEBUGGEE, write the COMMAND and its arguments
(separated by a space or \$ECHOTRACE_IFS) as an execution trace (i.e. with \$PS4
prepended and indicating the nesting level) to a debug file (DEBUGGEE.log) /
\$ECHOTRACE_SINK / \$DEBUG_SINK without actually executing COMMAND. (Basically
"set -x" but without the execution.) Else, the COMMAND is just executed as if
echotrace weren't prepended.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage ''
}

debuggee="$DEBUG_DEBUGGEE"
module=
isEval=
isLogStdin=
stdinModule=
stdinModuleEnabler=
option() { :; }
parameter() { :; }
parameterToSep() { :; }
argCount() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			parameterToSep() { argCount "$@"; }
			argCount() { local argCount="${1:?}"; shift; isUnderstandSubtopic "$@" || exit 1; printf $argCount; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--for)		shift; debuggee="${1?}"; shift; parameter debug;;
	--module|-m)	shift; module="${1:?}"; shift; parameter debug;;
	--stdin|-0)	shift; isLogStdin=t; option io;;
	--io-modules)	shift
			stdinModule='input'; stdinModuleEnabler+=t
			option debug-io
			;;
	--stdin-module)	shift; stdinModule="${1:?}"; shift; stdinModuleEnabler+=t; parameter debug-io;;
	--eval)		shift; isEval=t; option eval;;
	--)		endOfOptionsAndParameters; shift; break;;
	-*)		noUnderstand; { echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		endOfOptionsAndParameters; break;;
    esac
done
[ $# -eq 0 ] && exit
[ -n "$stdinModule" ] && isLogStdin=

printer()
{
    PRETTYPRINTQUOTEDARGS_IFS="$ECHOTRACE_IFS" \
    PRETTYPRINTQUOTEDARGS_PREFIX="$printerPrefix" \
	prettyPrintQuotedArgs -- "$@" >&3
}
executor()
{
    [ "$1" = eval ] && EXEC=''
    $EXEC "$@"
}
if [ "$isEval" ] && [ "$1" = eval ]; then
    shift
    executor()
    {
	eval "$@"
    }
    printer()
    {
	joinBy >&3 --prefix "${printerPrefix}" -- "$ECHOTRACE_IFS" "$@"
    }
fi

logStdin()
{
    while IFS=$'\n' read -r line || [ -n "$line" ]
    do
	printf '%s\n' "$line" >&3
    done
}

setSinkDefaults()
{
    case ",${DEBUG}," in
	*,@(debug|${scriptName})=*,*)
	    ECHOTRACE_SINK=",${DEBUG},"; ECHOTRACE_SINK="${ECHOTRACE_SINK#*,@(debug|${scriptName})=}"; ECHOTRACE_SINK="${ECHOTRACE_SINK%%,*}"
	    ;;
    esac
    timestampPrefix="$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging})"
}


timestampPrefix=
if [ -z "$debuggee" ]; then
    {
	IFS= read -r -d '' debugCmd
	IFS= read -r -d '' debugSecond
    } < /proc/${ECHOTRACE_PPID:-$PPID}/cmdline
    debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
fi

case ",${DEBUG}," in
    *,${debuggee}:${stdinModule},*)
	setSinkDefaults
	isLogStdin=t
	;;
    *,${debuggee}${module:+:}${module},*)
	setSinkDefaults
	;;
    *,@(debug|${scriptName}),*)
	{
	    if [ "$isLogStdin" ]; then
		printf >/dev/tty '%s: Will skip command execution and just log the command and stdin with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    elif [ -n "$stdinModule" ]; then
		printf >/dev/tty '%s: Will skip command execution and just log the command with DEBUG=%q, stdin with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}" "${debuggee}:${stdinModule}"
	    else
		printf >/dev/tty '%s: Will skip command execution and just log the command with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    fi
	} 2>/dev/null
	;&
    *)  executor "$@"
	exit $?
	;;
esac

: ${DEBUG_SINK="${PWD}/${debuggee//:/-}.log"}
sink="${ECHOTRACE_SINK-$DEBUG_SINK}"
case "$sink" in
    '')		exec 3>&2;;
    \&+([0-9]))	eval "exec 3>$sink";;
    ?*)		exec 3>>"$sink";;
esac

nestingPrefix="$(PS4='! ' debugNestingPrefix)"
ECHOTRACE_IFS="${ECHOTRACE_IFS//$'\n'/$'\n'${nestingPrefix}}"
printerPrefix="${timestampPrefix}${timestampPrefix:+ }${nestingPrefix}"

printer "$@"
[ ! "$isLogStdin" ] || logStdin
