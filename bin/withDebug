#!/bin/bash
shopt -qs globstar extglob nullglob

: ${WITHDEBUG_COMMAND_JOINER=;}
: ${WITHDEBUG_EXEC_END=;}

readonly DATA_DIRSPEC="${XDG_DATA_HOME:-${HOME}/.local/share}"
readonly WITHDEBUG_RECALL_FILESPEC="${DATA_DIRSPEC}/withDebug-recall"
readonly WITHDEBUG_SAME_FILESPEC="${DATA_DIRSPEC}/withDebug-same"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "[-1|--stdout] [-2|--stderr] [-a|--append|-P|--no-pager] [--to FILE|-i|--inbox|-s|--to-separate-files|-t|--to-tty] [-T|--no-timestamps] [-I|--interactive] [-v|--verbose] (-l|--list-targets | [-m|--module MODULE|'' [-m ...]|-M|--only-module MODULE|'' [-M ...]] [-x|--extension EXTENSION|'' [-x ...]]) --[only-]for COMMANDNAME [--[only-]for ...] [-?|-h|--help] ..."
    printf 'Usage: %q %s\n' "$(basename "$1")" "... [--same] -c|--command \"COMMANDLINE\" [...] | --exec SIMPLECOMMAND [...] ${WITHDEBUG_EXEC_END} [--exec ...] | [--] SIMPLECOMMAND [...] [-?|-h|--help]"
    printf 'Usage: %q %s\n' "$(basename "$1")" '... --recall'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Execute COMMAND while enabling debugging diagnostics for it. This is done by
adding the COMMAND's name to the \$DEBUG environment variable.
If DEBUG_<command-name>[_<module>]_WRAPPER environment variables exist, their
contents are prepended before the corresponding COMMAND and that executed
instead.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --stdout|-1		Include standard output in the debugging diagnostics.
    --stderr|-2		Include standard error in the debugging diagnostics.
    --append|-a		Append the debugging diagnostics to the existing log
			file instead of overwriting it.
    --no-pager|-P	Don't open the debugging diagnostics in the pager after
			the execution.
    --to FILE		Write the debugging diagnostics into FILE instead of the
			default COMMAND.log (using the first passed COMMAND).
    --inbox|-i		Write the debugging diagnostics into the inbox.
    --to-separate-files|-s
			Let each COMMAND write its debugging diagnostics into a
			separate log file (COMMAND.log) instead of collecting
			everything into a single log file (named after the first
			passed COMMAND) / the inbox.
    --to-tty|-t		Write the debugging diagnostics to the terminal instead.
    --no-timestamps|-T	Don't prepend timestamps to the debugging diagnostics.
    --interactive|-I	Source the COMMAND in an interactive shell. Only works
			if COMMAND starts with "." or "source".
    --verbose|-v	Print the full command line (with all debugging
			configuration) before executing it, in a format suitable
			for copy-and-pasting it into the shell.
    --list-targets|-l	Execute COMMAND while showing the COMMAND(s), MODULE(s),
			and EXTENSION(s) that could be enabled; i.e. which debug
			statements are actually hit and what they react on.
    --module|-m MODULE	Also enable debugging diagnostics for MODULE of the
			following COMMAND(s).
    --only-module|-M MODULE
			Just enable debugging diagnostics for MODULE of the
			following COMMAND(s), but not for the overall COMMAND
			itself.
    --[only-]module ''	Reset modules; following COMMAND(s) just print the
			overall debugging diagnostics.
    --extension|-x EXTENSION
			Append EXTENSION to the COMMANDNAME; e.g. a sigil like
			"!" or a directive like "+=SUFFIX" that modify the
			debugging behavior of some commands.
    --extension|-x ''	When given first: Also enable debugging diagnostics for
			the plain COMMANDNAME without any extension in addition
			to any following EXTENSION(s).
			When given after another --extension: Reset extensions;
			following COMMAND(s) just use the plain COMMANDNAME as
			the debuggee.
    --for COMMANDNAME	Also enable debugging diagnostics and wrapper commands
			for COMMANDNAME.
    --only-for COMMANDNAME
			Just enable debugging diagnostics and wrapper commands
			for COMMANDNAME, but not for any following --command or
			--exec COMMAND(s) or [--] SIMPLECOMMAND.
    --command|-c CMD	Execute CMD as a command-line.
    --exec CMD [...] ${WITHDEBUG_EXEC_END}	Execute CMD; all following arguments are taken to be
			arguments to the CMD until an argument consisting of
			'${WITHDEBUG_EXEC_END}' is encountered.
    --same		Execute COMMAND with the same debugging options (but
			unlike --recall not the actual COMMAND(s)) as the
			previous invocation of withDebug, optionally dropping
			matching arguments or adding those not given to the
			original command.
    --recall		Rerun the previous debugging COMMAND(s), optionally
			dropping matching arguments or adding those not given to
			the original command.
HELPTEXT
}

isOnly=
typeset -a modules=('')
addModule()
{
    [ -n "$1" ] && modules+=("$1")
}

add()
{
    DEBUG+="${DEBUG:+,}${1:?}"
}

isListTargets=
typeset -a commandNames=()
addDebug()
{
    commandName="${1:?}"; shift
    commandNames+=("$commandName")

    [ "$isListTargets" ] && return 0

    local module; for module in "${modules[@]}"
    do
	[ ${#extensions[@]} -gt 0 ] \
	    && typeset -a debugExtensions=("${extensions[@]}") \
	    || typeset -a debugExtensions=('')

	local extension; for extension in "${debugExtensions[@]}"
	do
	    add "${commandName}${extension}${module:+:}${module}"
	done
    done
}

hasTraceSupport()
{
    local commandFilespec="${1:?}"; shift
    grep --quiet \
	    -e '\${DEBUG:+eval \$(\(DEBUG[^[:space:]]\+[[:space:]]\+\)\?debugtrace[[:space:]]' \
	    -- "$commandFilespec"
}
commands=
addCommand()
{
    local cmd="${1:?}"; shift
    local isDebugEnable="${1?}"; shift

    if [ "$isDebugEnable" ]; then
	local wrappers='' commandName isTraceCommand
	for commandName in "${commandNames[@]}"
	do
	    local module; for module in "${modules[@]}"
	    do
		local wrapperConfigName="DEBUG_${commandName//[^[:alnum:]]/_}${module:+_}${module//[^[:alnum:]]/_}_WRAPPER"
		if [ -n "${!wrapperConfigName}" ]; then
		    # Prepend the wrapper command to the executed command.
		    wrappers+="${!wrapperConfigName} "
		fi
	    done

	    contains "&${commandName}" "${extensions[@]}" && isTraceCommand=t
	done

	if contains '&' "${extensions[@]}" || [ "$isTraceCommand" ]; then
	    local commandFilespec="$(COMMANDNAME_WRAPPERS='' commandName --no-interpreter --full-filespec --eval "$cmd")"
	    if [ -n "$commandFilespec" ] \
		&& [ -r "$commandFilespec" ] \
		&& ! hasTraceSupport "$commandFilespec"
	    then
		if [ -n "$wrappers" ]; then
		    printf >&2 'Note: Cannot enable tracing for %s without built-in debugtrace support when a wrapper is configured.\n' "$commandFilespec"
		else
		    printf -v cmd '(BASH_ARGV0=%q; set -x; . %s)' "$commandFilespec" "$cmd"
		fi
	    fi
	fi
    fi

    commands+="${commands:+ $WITHDEBUG_COMMAND_JOINER }${wrappers}${cmd}"
}

isAddDebugCommand=t
programName=
addDebugCommand()
{
    local cmd="${1:?}"; shift
    commandName="$(COMMANDNAME_WRAPPERS='' commandName --no-interpreter --eval "$cmd")"
    if [ -z "$commandName" ]; then
	printf >&2 'ERROR: Could not determine command name for %s\n' "$cmd"
	return 1
    fi

    if [[ "$cmd" =~ ^(\.|source)[[:space:]]+ ]]; then
	: ${programName:=$commandName}
    fi

    [ ! "$isAddDebugCommand" ] || addDebug "$commandName"
    addCommand "$cmd" "$isAddDebugCommand"
}

handleStoredArguments()
{
    local storedArgumentFilespec="${1:?}"; shift
    local isKeepCommandArgs="${1?}"; shift

    if [ ! -r "$storedArgumentFilespec" ]; then
	echo >&2 'ERROR: No previous debug command.'
	exit 1
    fi

    local overrideToStdout=
    local overrideToStderr=
    local overrideAppend=
    local overrideInteractive=
    local overrideVerbose=
    local overridePaginate=
    local overrideInbox=
    local overrideSeparateFiles=
    local overrideToTTY=
    local overrideNoTimestamps=
    local overrideTo=
    typeset -A overrideFor=()
    typeset -A overrideOnlyFor=()
    typeset -A overrideModules=()
    typeset -A overrideOnlyModules=()
    typeset -A overrideExtensions=()
    typeset -a commandArgs=()
    while [ $# -ne 0 ]
    do
	case "$1" in
	    --stdout|-1)	shift; overrideStdout=t;;
	    --stderr|-2)	shift; overrideStderr=t;;
	    --append|-a)	shift; overrideAppend=t;;
	    --interactive|-I)	shift; overrideInteractive=t;;
	    --verbose|-v)	shift; overrideVerbose=t;;
	    --no-pager|-P)	shift; overridePaginate=t;;
	    --inbox|-i)		shift; overrideInbox=t;;
	    --to-separate-files|-s)
				shift; overrideSeparateFiles=t;;
	    --to-tty|-t)	shift; overrideToTTY=t;;
	    --no-timestamps|-T)	shift; overrideNoTimestamps=t;;
	    --to)		shift; overrideTo="$1"; shift;;
	    --for)		shift; overrideFor["$1"]=t; shift;;
	    --only-for)		shift; overrideOnlyFor["$1"]=t; shift;;
	    --module|-m)	shift; overrideModules["$1"]=t; shift;;
	    --only-module|-M)	shift; overrideOnlyModules["$1"]=t; shift;;
	    --extension|-x)	shift; overrideExtensions["$1"]=t; shift;;
	    --command|-c)	commandArgs+=("$1" "$2"); shift; shift;;
	    --exec)		commandArgs+=("$1"); shift
				while [ $# -gt 0 -a "$1" != "$WITHDEBUG_EXEC_END" ]
				do
				    commandArgs+=("$1"); shift
				done
				commandArgs+=("$1"); shift
				;;
	    --)			commandArgs+=("$1"); shift; break;;
	    *)			commandArgs+=("$1"); shift;;
	esac
    done

    source "$storedArgumentFilespec" || exit 3

    # Iterate over the previously given arguments to remove those also given now.
    allargs=()	# These will be returned.
    while [ $# -ne 0 ]
    do
	case "$1" in
	    --stdout|-1)	[ "$overrideStdout" ] && overrideStdout= || allargs+=("$1"); shift;;
	    --stderr|-2)	[ "$overrideStderr" ] && overrideStderr= || allargs+=("$1"); shift;;
	    --append|-a)	[ "$overrideAppend" ] && overrideAppend= || allargs+=("$1"); shift;;
	    --interactive|-I)	[ "$overrideInteractive" ] && overrideInteractive= || allargs+=("$1"); shift;;
	    --verbose|-v)	[ "$overrideVerbose" ] && overrideVerbose= || allargs+=("$1"); shift;;
	    --no-pager|-P)	[ "$overridePaginate" ] && overridePaginate= || allargs+=("$1"); shift;;
	    --inbox|-i)		[ "$overrideInbox" ] && overrideInbox= || allargs+=("$1"); shift;;
	    --to-separate-files|-s)
				[ "$overrideSeparateFiles" ] && overrideSeparateFiles= || allargs+=("$1"); shift;;
	    --to-tty|-t)	[ "$overrideToTTY" ] && overrideToTTY= || allargs+=("$1"); shift;;
	    --no-timestamps|-T)	[ "$overrideNoTimestamps" ] && overrideNoTimestamps= || allargs+=("$1"); shift;;
	    --to)		[ -n "$overrideTo" ] && overrideTo= || allargs+=("$1" "$2"); shift; shift;;
	    --for)		[ "${overrideFor["$2"]}" ] && unset "overrideFor[$2]" || allargs+=("$1" "$2"); shift; shift;;
	    --only-for)		[ "${overrideOnlyFor["$2"]}" ] && unset "overrideOnlyFor[$2]" || allargs+=("$1" "$2"); shift; shift;;
	    --module|-m)	[ "${overrideModules["$2"]}" ] && unset "overrideModules[$2]" || allargs+=("$1" "$2"); shift; shift;;
	    --only-module|-M)   [ "${overrideOnlyModules["$2"]}" ] && unset "overrideOnlyModules[$2]" || allargs+=("$1" "$2"); shift; shift;;
	    --extension|-x)	[ "${overrideExtensions["$2"]}" ] && unset "overrideExtension[$2]" || allargs+=("$1" "$2"); shift; shift;;
	    --)			allargs+=("$@"); break;;
	    *)			allargs+=("$1"); shift;;
	esac
    done

    # Add those arguments given now (which were not used to remove any previous
    # arguments).
    typeset -a newArgs=()
    [ "$overrideStdout" ] && newArgs+=(--stdout)
    [ "$overrideStderr" ] && newArgs+=(--stderr)
    [ "$overrideAppend" ] && newArgs+=(--append)
    [ "$overrideInteractive" ] && newArgs+=(--interactive)
    [ "$overrideVerbose" ] && newArgs+=(--verbose)
    [ "$overridePaginate" ] && newArgs+=(--no-pager)
    [ "$overrideInbox" ] && newArgs+=(--inbox)
    [ "$overrideSeparateFiles" ] && newArgs+=(--to-separate-files)
    [ "$overrideToTTY" ] && newArgs+=(--to-tty)
    [ "$overrideNoTimestamps" ] && newArgs+=(--no-timestamps)
    [ -n "$overrideTo" ] && newArgs+=(--to "$overrideTo")
    local arg
    for arg in "${!overrideFor[@]}"
    do
	newArgs+=(--for "$arg")
    done
    for arg in "${!overrideOnlyFor[@]}"
    do
	newArgs+=(--only-for "$arg")
    done
    for arg in "${!overrideModules[@]}"
    do
	newArgs+=(--module "$arg")
    done
    for arg in "${!overrideOnlyModules[@]}"
    do
	newArgs+=(--only-module "$arg")
    done
    for arg in "${!overrideExtensions[@]}"
    do
	newArgs+=(--extension "$arg")
    done

    # Return via allargs array.
    allargs=("${newArgs[@]}" "${allargs[@]}")
    [ ! "$isKeepCommandArgs" ] || allargs+=("${commandArgs[@]}")
}

saveToInbox()
{
    inbox --base "${programName:-${commandNames[0]:?}}"
}

typeset -a allargs=("$@")
typeset -a nonCommandArgs=()
isIncludeStdout=
isIncludeStderr=
isAppend=
isInteractive=
isVerbose=
typeset -a extensions=()
let commandCnt=0
unset sink
pagerCommand="${PAGER:-less}"
[ "$pagerCommand" = smartless ] && pagerCommand=less	# smartless does not page small outputs that fit the terminal, but we explicitly want to page through the captured debug diagnostics.
typeset -a captureCommand=()
typeset -a pager=("$pagerCommand" --RAW-CONTROL-CHARS --)
typeset -a prePagerCommand=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--same)		shift; handleStoredArguments "$WITHDEBUG_SAME_FILESPEC" t "$@"; set -- "${allargs[@]}";;
	--recall)	shift; handleStoredArguments "$WITHDEBUG_RECALL_FILESPEC" '' "$@"; set -- "${allargs[@]}";;
	--list-targets|-l)
			# Note: Not covered by --same nor --recall.
			shift
			isListTargets=t; add debug
			prePagerCommand=(pipethrough1 sort --unique)
			;;

	--stdout|-1)	nonCommandArgs+=("$1"); shift; isIncludeStdout=t;;
	--stderr|-2)	nonCommandArgs+=("$1"); shift; isIncludeStderr=t;;
	--append|-a)	nonCommandArgs+=("$1"); shift; isAppend=t;;
	--no-pager|-P)	nonCommandArgs+=("$1"); shift; pager=();;
	--to)		nonCommandArgs+=("$1" "$2"); shift; sink="${1:?}"; shift;;
	--inbox|-i)	nonCommandArgs+=("$1"); shift; captureCommand=(saveToInbox); pager=();;
	--to-separate-files|-s)
			nonCommandArgs+=("$1"); shift; sink='';;
	--to-tty|-t)	nonCommandArgs+=("$1"); shift; sink='/dev/tty'; pager=()
			[ -n "${DEBUG_TIMESTAMP_COMMAND+t}" ] || export DEBUG_TIMESTAMP_COMMAND=''
			;;
	--no-timestamps|-T)
			nonCommandArgs+=("$1"); shift; export DEBUG_TIMESTAMP_COMMAND='';;
	--interactive|-I)
			nonCommandArgs+=("$1"); shift; isInteractive=t;;
	--verbose|-v)	nonCommandArgs+=("$1"); shift; isVerbose=t;;
	--for)		nonCommandArgs+=("$1" "$2"); shift
			addDebug "${1:?}"; shift
			;;
	--only-for)	nonCommandArgs+=("$1" "$2"); shift
			addDebug "${1:?}"; shift
			isAddDebugCommand=
			;;
	--module|-m)	nonCommandArgs+=("$1" "$2"); shift
			[ "$isOnly" ] && modules=('')
			isOnly=
			addModule "${1?}"; shift
			;;
	--only-module|-M)
			nonCommandArgs+=("$1" "$2"); shift
			[ "$isOnly" ] || modules=()
			isOnly=t
			addModule "${1?}"; shift
			;;
	--extension|-x)	nonCommandArgs+=("$1" "$2"); shift
			if [ -z "${1?}" ]; then
			    [ ${#extensions[@]} -eq 0 ] \
				&& extensions+=('') \
				|| extensions=()
			else
			    extensions+=("$1")
			fi; shift
			;;
	--command|-c)	shift
			addDebugCommand "${1:?}" || exit 2
			if [[ "$1" =~ [\;\&\|] ]]; then
			    let commandCnt+=2	# multiple commands
			else
			    let commandCnt+=1
			fi
			shift
			;;
	--exec)		shift
			cmd=
			while [ $# -gt 0 -a "$1" != "$WITHDEBUG_EXEC_END" ]
			do
			    printf -v quotedArg '%q' "$1"
			    cmd+="${cmd:+ }${quotedArg}"
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --exec command must be concluded with '${WITHDEBUG_EXEC_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			addDebugCommand "$cmd" || exit 2
			let commandCnt+=1
			;;
	--)		nonCommandArgs+=("$1"); shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 0 ]; then
    # Combine --command and SIMPLECOMMAND; need to quote SIMPLECOMMAND to
    # undo the effects of eval.
    printf -v quotedSimpleCommand '%q ' "$@"
    quotedSimpleCommand="${quotedSimpleCommand% }"
    addDebugCommand "$quotedSimpleCommand" || exit 2
    if [ "${#commandNames[@]}" -gt 1 ]; then
	# Use the trailing SIMPLECOMMAND as the command name for the log file, not the
	# first --command|--exec COMMAND.
	commandNames=("${commandNames[-1]}" "${commandNames[@]:0:${#commandNames[@]}-1}")
    fi
    let commandCnt+=1
fi
if [ -n "${sink+t}" -a ${#captureCommand[@]} -gt 0 ]; then
    echo 'ERROR: Cannot combine --to FILE or -s|--to-separate-files or -t|--to-tty with -i|--inbox.'
    echo
    printUsage "$0"
    exit 2
elif [ -z "$commands" ]; then
    echo "ERROR: No COMMAND(s) specified; need to pass -c|--command \"COMMANDLINE\", or --exec SIMPLECOMMAND [...] $WITHDEBUG_EXEC_END or SIMPLECOMMAND."
    echo
    printUsage "$0"
    exit 2
fi >&2

printf -v quotedArgs ' %q' "${allargs[@]}"
printf 'set --%s\n' "$quotedArgs" > "$WITHDEBUG_RECALL_FILESPEC"
printf -v quotedArgs ' %q' "${nonCommandArgs[@]}"
printf 'set --%s\n' "$quotedArgs" > "$WITHDEBUG_SAME_FILESPEC"

if [ "$isVerbose" ]; then
    if [ $commandCnt -eq 1 ]; then
	printf >&2 '%sDEBUG=%q %s\n' "${PS4:-\$ }" "$DEBUG" "$commands"
    else
	printf >&2 '%s{ DEBUG=%q; %s; }\n' "${PS4:-\$ }" "$DEBUG" "$commands"
    fi
fi

export DEBUG

if [ -n "$programName" ]; then
    shift   # .|source
    shift   # $programName
    export DEBUG_DEBUGGEE="$programName"
    BASH_ARGV0="$programName"	# Bash 5+ only

    if [ "$isInteractive" ]; then
	printf -v commands 'bash -i -c %q' "$commands"
    fi
    : ${sink="${programName}.log"}
else
    : ${sink="${commandNames[0]:?}.log"}
fi

if [ ${#captureCommand[@]} -gt 0 ]; then
    for ((i = 0; i < 5; i++))
    do
	TMPFIFO="$(mktemp --dry-run --tmpdir="${XDG_RUNTIME_DIR:-/tmp}" "$(basename -- "$0")-XXXXXX" 2>/dev/null || echo "${XDG_RUNTIME_DIR:-/tmp}/$(basename -- "$0").$$$RANDOM")"
	mkfifo -m 600 "$TMPFIFO" 2>/dev/null && break	# mkfifo fails when the file already exists; this handles the race condition.
    done

    { "${captureCommand[@]}" < "$TMPFIFO"; } &	# Start the reader first.
    capturePID=$!
    exec 3>"$TMPFIFO"	# Open the pipe for writing; this will block until the reader is ready.
    rm -- "$TMPFIFO" # Unlink the named pipe.

    sink='&3'
    export DEBUG_SINK="$sink"
    export BASH_XTRACEFD=3    # Capture "set -x" output by the log sink command, too.
    closeFifo()
    {
	exec 3>&- # Close the pipe.
	wait $capturePID
    }
    trap closeFifo EXIT
elif [ -n "${sink+t}" -a -z "$sink" ]; then
    if [ "$isIncludeStdout" ] || [ "$isIncludeStderr" ]; then
	echo 'ERROR: Cannot combine -1|--stdout or -2|--stderr with -s|--to-separate-files.'
	echo
	printUsage "$0"
	exit 2
    fi
    # Let each command write to its own log file; do not create a single log file.
else
    [ "$isAppend" ] || : > "$sink"
    exec 3>>"${sink:?}"; export BASH_XTRACEFD=3	# Capture "set -x" output in the log file, too.
    export DEBUG_SINK="$sink"

    if [ ${#pager[@]} -gt 0 ]; then
	openPager()
	{
	    [ "$isIncludeStdout" ] && exec 1>&4
	    [ "$isIncludeStderr" ] && exec 2>&5
	    [ ${#prePagerCommand[@]} -eq 0 ] || "${prePagerCommand[@]}" "$sink"
	    "${pager[@]}" "$sink"
	}
	trap openPager EXIT
    elif [ -f "$sink" ]; then
	printLogLocation()
	{
	    [ -s "$sink" ] \
		&& local message="Debugging diagnostics written to $sink" \
		|| local message='No debugging diagnostics logged.'
	    { printf >/dev/tty '%s%s\n' "$PS4" "$message"; } 2>/dev/null
	}
	trap printLogLocation EXIT
    fi
fi

if [ "$isIncludeStdout" ]; then
    exec 4>&1 1>&3
fi
if [ "$isIncludeStderr" ]; then
    exec 5>&1 2>&3
fi

# This command itself creates one more nesting level.
: ${DEBUGNESTINGPREFIX_OFFSET:=0}; let DEBUGNESTINGPREFIX_OFFSET+=1; export DEBUGNESTINGPREFIX_OFFSET

eval "$commands"
