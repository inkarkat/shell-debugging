#!/bin/bash
shopt -qs extglob

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    [ "$isLogF" ] \
	&& local args='[--prefix PREFIX [--prefix ...]] [--suffix SUFFIX [--suffix ...]] [--] FORMAT [ARG ...]' \
	|| local args='[--] [MESSAGE ...]'
    printf 'Usage: ${DEBUG:+[env DEBUG[LOG]_SINK=FILESPEC|&N] %q %s}\n' "$(basename "$1")${isLogF:+f}" "[--for DEBUGGEE] [-m|--module MODULE] $args [-?|-h|--help]"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
${isLogF:+Format and }Log MESSAGE (in the format TIMESTAMP (PID) MESSAGE ...) to a debug
file (DEBUGGEE.log) / \$DEBUGLOG_SINK / \$DEBUG_LOG if debugging is enabled for
the caller:
DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
With "DEBUG=debug[log]=FILESPEC,DEBUGGEE[:MODULE] DEBUGGEE ..." will log to
FILESPEC instead.
With "DEBUG=debug[log] DEBUGGEE ..." will show for what DEBUGGEE it will
enable (if not actually enabled).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
EXIT STATUS:
    2	Bad invocation, wrong or missing command-line arguments.
HELPTEXT
}

isLogF=
debuggee="$DEBUG_DEBUGGEE"
module=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--logf)		shift; isLogF=t;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done

[ -n "$DEBUG" ] || exit 0

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
if [ -z "$debuggee" ]; then
    {
	IFS= read -r -d '' debugCmd
	IFS= read -r -d '' debugSecond
    } < /proc/${PPID}/cmdline
    debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
fi

case ",${DEBUG:-}," in
    *,${debuggee}${module:+:}${module},*)
	case ",${DEBUG:-}," in
	    *,@(debug|${scriptName})=*,*) DEBUGLOG_SINK=",${DEBUG},"; DEBUGLOG_SINK="${DEBUGLOG_SINK#*,@(debug|${scriptName})=}"; DEBUGLOG_SINK="${DEBUGLOG_SINK%%,*}"
			    ;;
	    *)		    : ${DEBUG_SINK:="${PWD}/${debuggee//:/-}.log"};;
	esac

	sink="${DEBUGLOG_SINK:-$DEBUG_SINK}"
	case "$sink" in
	    '')		echo >&2 'ASSERT: Sink is non-empty.'; exit 3;;
	    \&+([0-9]))	eval "exec >$sink";;
	    ?*)		exec >>"$sink";;
	esac

	[ -n "${DEBUG_TIMESTAMP_COMMAND+t}" ] && export LOG_TIMESTAMP_COMMAND="$DEBUG_TIMESTAMP_COMMAND"
	if [ "$isLogF" ]; then
	    logf --prefix "$debuggee (${module}${module:+, }${PPID}) " "$@"
	else
	    log "$debuggee (${module}${module:+, }${PPID})" "$@"
	fi
	;;
    *,@(debug|${scriptName}),*)
	{ printf >/dev/tty '%s: Will activate with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"; } 2>/dev/null
	;;
esac
exit 0
