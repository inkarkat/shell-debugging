#!/bin/bash
shopt -qs extglob

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
readonly generalArgs='[-a|--array NAME] [-v|--verbose] [--D|--on-debug [--for DEBUGGEE] [-m|--module MODULE]]'
getShortUsage()
{
    printf %s "$generalArgs"
}
getLongUsage()
{
    cat <<HELPTEXT
    --array|-a NAME	ARG(s) originate from an array named NAME and are
			printed as such (with 0-based index).
    --verbose|-v	Print each argument on a separate line and prepend the
			index.
    --on-debug|-D	Log ARG(s) to a debug file (DEBUGGEE.log) only when
			\$DEBUG refers to the DEBUGGEE, and print the debug
			filespec to the terminal.
$ DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
$ DEBUG=debug|${scriptName}=FILE,DEBUGGEE[:MODULE] DEBUGGEE ... will log to a custom
  FILE instead.
$ DEBUG=debug|${scriptName} DEBUGGEE ... will show for what DEBUGGEE it will enable (if not
  actually enabled).
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
HELPTEXT
}

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [[DUMPARGS|DEBUG]_SINK=FILESPEC|&N] %q %s\n' "$(basename "$1")" "$generalArgs [--] [ARG ...] [-?|-h|--help]"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Just print all supplied command-line arguments to standard error /
\$DUMPARGS_SINK / \$DEBUG_SINK.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage
    cat <<HELPTEXT
SEE ALSO:
- dump-args-exec also executes COMMAND in addition to printing them.
- debuglog[f] log a MESSAGE with timestamp to a debug file if debugging is
  enabled for the caller.

EXIT STATUS:
    0	Complete success.
    2	Bad invocation, wrong or missing command-line arguments.
    99	Debugging is not enabled for the DEBUGGEE.
HELPTEXT
}

defaultPrefix=''
defaultSuffix=''
isVerbose=
verbosePrefix=''
verboseSuffix=': '
isOnDebug=
debuggee=
module=
startIndex=1
option() { :; }
parameter() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understands)	shift
			option() { printf 1; exit 0; }
			parameter() { printf 2; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--array|-a)	shift; defaultPrefix="$1=("; defaultSuffix=')'; verbosePrefix="$1["; verboseSuffix=']='; startIndex=0; shift; option;;
	--on-debug|-D)	shift; isOnDebug=t; option;;
	--for)		shift; debuggee="${1?}"; shift; parameter;;
	--module|-m)	shift; module="${1:?}"; shift; parameter;;
	--verbose|-v)	shift; isVerbose=t; option;;
	--)		endOfOptionsAndParameters; shift; break;;
	-*)		noUnderstand; { echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		endOfOptionsAndParameters; break;;
    esac
done

printfToTerm()
{
    { printf >/dev/tty "$@"; } 2>/dev/null
}

if [ "$isOnDebug" ]; then
    [ -n "$DEBUG" ] || exit 99

    if [ -z "$debuggee" ]; then
	{
	    IFS= read -r -d '' debugCmd
	    IFS= read -r -d '' debugSecond
	} < /proc/${DUMPARGS_PPID:-$PPID}/cmdline
	debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
    fi

    case ",${DEBUG:-}," in
	*,${debuggee}${module:+:}${module},*)
	    case ",${DEBUG:-}," in
		*,@(debug|${scriptName})=*,*)
		    DUMPARGS_SINK=",${DEBUG},"; DUMPARGS_SINK="${DUMPARGS_SINK#*,@(debug|${scriptName})=}"; DUMPARGS_SINK="${DUMPARGS_SINK%%,*}"
		    ;;
		*)  : ${DEBUG_SINK:="${PWD}/${debuggee//:/-}.log"};;
	    esac
	    ;;
	*,@(debug|${scriptName}),*)
	    printfToTerm '%s: Will activate with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    exit 99
	    ;;
	*)  exit 99;;
    esac
fi

sink="${DUMPARGS_SINK:-${isOnDebug:+$DEBUG_SINK}}"
case "$sink" in
    '')		exec >&2;;
    \&[0-9])	eval "exec >$sink";;
    ?*)		exec >>"$sink";;
esac

if [ "$isVerbose" ]; then
    if [ $# -gt 0 ]; then
	let argCnt=$startIndex
	while [ $# -gt 0 ]
	do
	    PRETTYPRINTQUOTEDARGS_PREFIX="${verbosePrefix}${argCnt}${verboseSuffix}" \
		prettyPrintQuotedArgs -- "$1"
	    shift
	    let argCnt+=1
	done
    else
	printf '%s%s\n' "$defaultPrefix" "$defaultSuffix"
    fi
else
    quotedArgs=; if [ $# -gt 0 ]; then printf -v quotedArgs '%q ' "$@"; quotedArgs=${quotedArgs% }; fi
    if [ $# -gt 0 ]; then
	PRETTYPRINTQUOTEDARGS_PREFIX="$defaultPrefix" \
	    PRETTYPRINTQUOTEDARGS_SUFFIX="$defaultSuffix" \
	    prettyPrintQuotedArgs -- "$@"
    elif [ -n "${defaultPrefix}${defaultSuffix}" ]; then
	printf '%s%s\n' "$defaultPrefix" "$defaultSuffix"
    fi
fi

if [ $# -gt 0 ] && [ "$isOnDebug" ] && [ -n "$sink" ]; then
    printfToTerm "%s%s to %q\\n" "$(debugNestingPrefix)" "$scriptName" "$sink"
fi
