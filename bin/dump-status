#!/bin/bash
shopt -qs extglob

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [DUMPSTATUS_SINK=FILESPEC|&N|""] %q %s\n' "$(basename "$1")" '[-v|--verbose] [--] COMMAND [ARG ...] [-?|-h|--help]'
    printf 'Usage: ${DEBUG:+[env (DUMPSTATUS|DEBUG)_SINK=FILESPEC|&N|""] %q %s} %s\n' "$(basename "$1")" '-D|--on-debug [--for DEBUGGEE] [-m|--module MODULE] [--verbose] [--]' 'COMMAND [ARG ...]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Print the exit status of the supplied command-line to standard error /
\$DUMPSTATUS_SINK / \$DEBUG_SINK.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --verbose|-v	Also include the full command-line arguments.
    --on-debug|-D	Log the exit status to a debug file (DEBUGGEE.log) only
			when \$DEBUG refers to the DEBUGGEE, and print the debug
			filespec to the terminal.
$ DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
$ DEBUG=debug|${scriptName}=FILE,DEBUGGEE[:MODULE] DEBUGGEE ... will log to a
  custom FILE instead.
$ DEBUG=debug|${scriptName} DEBUGGEE ... will show for what DEBUGGEE it will
  enable (if not actually enabled).
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
HELPTEXT
}

isVerbose=
isOnDebug=
debuggee="$DEBUG_DEBUGGEE"
module=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--verbose|-v)	shift; isVerbose=t;;
	--on-debug|-D)	shift; isOnDebug=t;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -eq 0 ]; then
    echo >&2 'ERROR: No COMMAND passed.'
    echo >&2
    printUsage "$0" >&2
    exit 2
fi

"$@"
status=$?

unset sink
setSink()
{
    [ -n "${sink+t}" ] && return 0

    sink="${DUMPSTATUS_SINK:-${isOnDebug:+$DEBUG_SINK}}"
    case "$sink" in
	'')		exec >&2;;
	\&+([0-9]))	eval "exec >$sink";;
	?*)		exec >>"$sink";;
    esac
}

if [ "$isOnDebug" ]; then
    [ -n "$DEBUG" ] || exit 99

    if [ -z "$debuggee" ]; then
	{
	    IFS= read -r -d '' debugCmd
	    IFS= read -r -d '' debugSecond
	} < /proc/${DUMPARGS_PPID:-$PPID}/cmdline
	debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
    fi

    case ",${DEBUG}," in
	*,${debuggee}${module:+:}${module},*)
	    case ",${DEBUG}," in
		*,@(debug|${scriptName})=*,*)
		    DUMPSTATUS_SINK=",${DEBUG},"; DUMPSTATUS_SINK="${DUMPSTATUS_SINK#*,@(debug|${scriptName})=}"; DUMPSTATUS_SINK="${DUMPSTATUS_SINK%%,*}"
		    ;;
		*)  : ${DEBUG_SINK:="${PWD}/${debuggee//:/-}.log"};;
	    esac
	    ;;
	*,@(debug|${scriptName}),*)
	    setSink
	    printf '%s: Will activate with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    ;;
	*)  exit 99;;
    esac
fi

setSink

[ $# -gt 0 ] || exit 1

if [ "$isVerbose" ]; then
    quotedArgs=; if [ $# -gt 0 ]; then printf -v quotedArgs '%q ' "$@"; quotedArgs=${quotedArgs% }; fi
    printf '%s (%d)\n' "$quotedArgs" "$status"
else
    printf '%s (%d)\n' "$1" "$status"
fi
exit $status
