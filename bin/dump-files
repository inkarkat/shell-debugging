#!/bin/bash
shopt -qs extglob

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [DUMPFILES_SINK=FILESPEC|&N] %q %s\n' "$(basename "$1")" '[-n|--number] [--no-header|-d|--description DESCRIPTION] [-D|--on-debug [--for DEBUGGEE] [-m|--module MODULE]] [--] [-|FILE ...] [-?|-h|--help]'
    printf 'Usage: ${DEBUG:+[env (DUMPFILES|DEBUG)_SINK=FILESPEC|&N] %q %s}\n' "$(basename "$1")" '-D|--on-debug [--for DEBUGGEE] [-m|--module MODULE] ...'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Just print the contents of all supplied FILE(s) to standard error /
\$DUMPFILES_SINK / \$DEBUG_SINK.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --number|-n		Number all output lines.
    --no-header		Omit the header line with the [timestamp on debug and]
			filespec (which is printed by default).
    --description|-d DESCRIPTION
			Prepend DESCRIPTION to the header.
    --on-debug|-D	Log FILE contents to a debug file (DEBUGGEE.log) only
			when \$DEBUG refers to the DEBUGGEE, and print the debug
			filespec to the terminal.
$ DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
$ DEBUG=debug|${scriptName}=FILE,DEBUGGEE[:MODULE] DEBUGGEE ... will log to a
  custom FILE instead.
$ DEBUG=debug|${scriptName} DEBUGGEE ... will show for what DEBUGGEE it will enable
  (if not actually enabled).
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
SEE ALSO:
- debugtee duplicates stdin to a debug file when debugging is enabled.
- dump-args prints command-line arguments, not file contents to standard error.

EXIT STATUS:
    0	Complete success.
    1	No FILE(s).
    2	Bad invocation, wrong or missing command-line arguments.
    99	Debugging is not enabled for the DEBUGGEE.
HELPTEXT
}

isNumber=
isHeader=t
description=
isOnDebug=
debuggee="$DEBUG_DEBUGGEE"
module=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--number|-n)	shift; isNumber=t;;
	--no-header)	shift; isHeader=;;
	--description|-d)
			shift; description="${1?}"; shift;;
	--on-debug|-D)	shift; isOnDebug=t;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--)		shift; break;;
	-?*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done

printfToTerm()
{
    { printf >/dev/tty "$@"; } 2>/dev/null
}

if [ "$isOnDebug" ]; then
    [ -n "$DEBUG" ] || exit 99

    if [ -z "$debuggee" ]; then
	{
	    IFS= read -r -d '' debugCmd
	    IFS= read -r -d '' debugSecond
	} < /proc/${DUMPARGS_PPID:-$PPID}/cmdline
	debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
    fi

    case ",${DEBUG:-}," in
	*,${debuggee}${module:+:}${module},*)
	    case ",${DEBUG:-}," in
		*,@(debug|${scriptName})=*,*)
		    DUMPFILES_SINK=",${DEBUG},"; DUMPFILES_SINK="${DUMPFILES_SINK#*,@(debug|${scriptName})=}"; DUMPFILES_SINK="${DUMPFILES_SINK%%,*}"
		    ;;
		*)  : ${DEBUG_SINK:="${PWD}/${debuggee//:/-}.log"};;
	    esac
	    ;;
	*,@(debug|${scriptName}),*)
	    printfToTerm '%s: Will activate with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    exit 99
	    ;;
	*)  exit 99;;
    esac
fi

typeset -a colorArg=(--no-color)
sink="${DUMPFILES_SINK:-${isOnDebug:+$DEBUG_SINK}}"
case "$sink" in
    '')		exec >&2;;
    \&+([0-9]))	eval "exec >$sink";;
    /dev/tty)	colorArg=();;&
    ?*)		exec >>"$sink";;
esac

[ $# -gt 0 ] || exit 1

if [ "$isHeader" ]; then
    isFirst=t
    [ "$isOnDebug" ] && [ -s "$sink" ] && isFirst=
    let count=0
    for filespec
    do
	let count+=1
	[ "$filespec" = - ] \
	    && fileDescription='stdin' \
	    || fileDescription="$filespec"
	filePrefix=''; [ $# -gt 1 ] && filePrefix="${count}:"
	HEADER_STYLE=dashed-line \
	HEADER_PREFIX="${isOnDebug:+$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging}) }-- " \
	    header ${isFirst:+--first} "${colorArg[@]}" -- "${description}${description:+ }${filePrefix}${fileDescription}"
	isFirst=
	cat ${isNumber:+--number} -- "$filespec"
    done
elif [ $# -gt 0 ]; then
    cat ${isNumber:+--number} -- "$@"
fi
