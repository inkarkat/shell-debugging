#!/bin/bash
shopt -qs extglob

: ${DEBUGTRACE_ARGQUOTES=「」}
O="${DEBUGTRACE_ARGQUOTES:0:1}"; C="${DEBUGTRACE_ARGQUOTES:1:1}"

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }
readonly projectDir="${scriptDir}/.."
readonly libDir="${projectDir}/lib"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: ${DEBUG:+eval $([DEBUG[TRACE]_SINK=FILESPEC|&N|""] %q %s)}\n' "$(basename "$1")" '[--for DEBUGGEE] [-m|--module MODULE] [--to FILE] [-d|--description DESCRIPTION] [-p|--point TRACE-POINT-NAME] [-o $-] [-- "$@"] [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
If debugging is not enabled for the caller, the execution is a no-op.
When \$DEBUG refers plainly to the DEBUGGEE, the hitting of this point is
logged [with DESCRIPTION] [with ARG(s)].
When \$DEBUG refers to DEBUGGEE![N], an exit command is printed so that the
caller exits prematurely [with an exit status of N].
When \$DEBUG refers to DEBUGGEE&, "set -x" is printed so that tracing is enabled
from that point on in the caller (regardless of whether the trace point has been
named or not).
When \$DEBUG refers to DEBUGGEE&NAME and NAME corresponds to the passed
TRACE-POINT-NAME, "set -x" is printed so that tracing is enabled from that point
on in the caller; else, "set +x" is printed so tracing stops at a different
trace point.
When \$DEBUG refers to DEBUGGEE=OTHER-COMMAND, OTHER-COMMAND is printed for
execution by the invoking eval, injecting that into the caller.
When \$DEBUG refers to DEBUGGEE@[N-]FILE, the execution makes the caller output
the contents of FILE and exit prematurely [with an exit status of N].
When \$DEBUG refers to DEBUGGEE/REPLACEMENT/ or DEBUGGEE//REPLACEMENT/, all
current ARG(s) are replaced by (shell-quoted) REPLACEMENT in the caller.
When \$DEBUG refers to DEBUGGEE/PATTERN/REPLACEMENT/, PATTERN in the
shell-quoted ARG(s) is globally substituted with REPLACEMENT and the resulting
ARG(s) are set in the caller.
When \$DEBUG refers to DEBUGGEE?PREDICATE, any other instructions for DEBUGGEE
are only considered if PREDICATE is successful.

Logging goes into a debug file (DEBUGGEE.log) / \$DEBUGTRACE_SINK / \$DEBUG_SINK.
DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
With "DEBUG=debug[trace]=FILESPEC,DEBUGGEE[:MODULE] DEBUGGEE ..." will log to
FILESPEC instead.
With "DEBUG=debug[trace] DEBUGGEE ..." will show for what DEBUGGEE it will
enable (if not actually enabled).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
    --to FILE		Use FILE instead of the default debug file DEBUGGEE.log
			for tracing and just leave a reference to FILE there.
    --description|-d DESCRIPTION
			Include DESCRIPTION in the log message for this trace
			point.
    --point|-p TRACE-POINT-NAME
			Uniquely identify this trace point when using multiple
			in the same DEBUGGEE, so that you can enable tracing for
			each separately.
    -o \$-		Pass the caller's current shell options to allow
			detection of whether debugging is currently enabled.
SEE ALSO:
- debugeval enables tracing for a single passed COMMAND instead of all following
  statements in the caller, and has similar replacements and embellishments for
  that COMMAND.
HELPTEXT
}

debuggee="$DEBUG_DEBUGGEE"
module=
toFile=
description=
tracePointName=
unset isTracing
hasArgs=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--to)		shift; toFile="${1:?}"; shift;;
	--description|-d)
			shift; description="${1?}"; shift;;
	--point|-p)	shift; tracePointName="${1:?}"; shift;;
	-o)		shift
			[[ "$1" = *x* ]] \
			    && isTracing=t \
			    || isTracing=
			shift
			;;
	--)		shift; hasArgs=t; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
[ -n "$DEBUG" ] || exit 0

source "${libDir}/directiveParser.sh" || exit 3

printfToSink()
{
    eval "printf \"\$@\" $redir"
}

logActions()
{
    local timestampPrefix="$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging})"
    local nestingPrefix="$(debugNestingPrefix)"
    local printerPrefix="${timestampPrefix}${timestampPrefix:+ }${nestingPrefix}"
    printf >&3 '%s%s %s%s\n' \
	"$printerPrefix" \
	"$debuggee (${module}${module:+, }${PPID})" \
	"reached ${tracePointName:-trace point}${description:+ (${description})}" \
	"$(joinBy --prefix '; ' ', ' "${actions[@]}")"
}

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
if [ -z "$debuggee" ]; then
    {
	IFS= read -r -d '' debugCmd
	IFS= read -r -d '' debugSecond
    } < /proc/${PPID}/cmdline
    debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
fi

case ",${DEBUG}," in
    *,@(debug|${scriptName})=*,*) DEBUGTRACE_SINK=",${DEBUG},"; DEBUGTRACE_SINK="${DEBUGTRACE_SINK#*,@(debug|${scriptName})=}"; DEBUGTRACE_SINK="${DEBUGTRACE_SINK%%,*}"
	;;
    *)  : ${DEBUG_SINK="${PWD}/${debuggee//:/-}.log"};;
esac

sink="${DEBUGTRACE_SINK-$DEBUG_SINK}"
redir=
sinkRedir=
traceRedir=
case "$sink" in
    '')		redir='>&2'
		sinkRedir="exec 3${redir}"
		traceRedir='BASH_XTRACEFD=2'
		;;
    \&+([0-9]))	redir=">$sink"
		sinkRedir="exec 3${redir}"
		traceRedir="${sinkRedir}; BASH_XTRACEFD=3"
		;;
    ?*)		printf -v redir '>>%q' "$sink"
		sinkRedir="exec 3${redir}"
		traceRedir="${sinkRedir}; BASH_XTRACEFD=3"
		;;
esac
handleToFile()
{
    [ -n "$toFile" ] || return 0

    # Redirect the captured output to the specified FILE.
    local originalTraceRedir="$traceRedir"
    printf -v redir '>>%q' "$toFile"
    sinkRedir="exec 3${redir}"
    traceRedir="${sinkRedir}; BASH_XTRACEFD=3"
    commands="${commands/"${originalTraceRedir}"/"${traceRedir}"}"

    toFile=''	# No-op if the function is called again.
}

commands=
typeset -a actions=()
isActive=
postLogCommand=

hadPredicate=; while debugConsumeDirectiveInto predicate '?'; do
    hadPredicate=t
    if [ -z "$predicate" ]; then
	isActive=t
	printfToSink '%s: Warning: Empty PREDICATE given for %q\n' "$scriptName" "${debuggee}${module:+:}${module}"
    elif eval "(${sinkRedir}; { ${predicate}; } >&3 2>&3)"; then
	isActive=t
    fi
done
[ "$hadPredicate" ] && [ ! "$isActive" ] && exit 0

while debugConsumeDirectiveInto otherCommand '='; do
    isActive=t
    if [ -z "$otherCommand" ]; then
	printfToSink '%s: Warning: Empty OTHER-COMMAND given for %q (better use DEBUGGEE!)\n' "$scriptName" "${debuggee}${module:+:}${module}"
    else
	actions+=("injecting ${O}${otherCommand}${C}")
	commands+="${commands:+; }${otherCommand}"
	export PS4='= '
    fi
done

previousFilespec=
filespecCommand=
while debugConsumeDirectiveInto filespec '@'; do
    isActive=t

    eval "expandedFilespec=$filespec" # Expand environment variables and tilde.
    if [ -n "$expandedFilespec" ]; then
	exitStatus=
	if [[ "$expandedFilespec" =~ ^(.*/)?([0-9]+)-(.+)$ ]]; then
	    exitStatus="${BASH_REMATCH[2]}"
	    expandedFilespec="${BASH_REMATCH[1]}${BASH_REMATCH[3]}"
	fi
	if [ -e "$expandedFilespec" ]; then
	    isActive=t
	    if [ -n "$previousFilespec" ]; then
		printfToSink '%s: Warning: Duplicate @%s given for %q\n' "$scriptName" "$previousFilespec" "${debuggee}${module:+:}${module}"
		actions[-1]="outputting ${expandedFilespec}${exitStatus:+ and exiting with $exitStatus}"
	    else
		actions+=("outputting ${expandedFilespec}${exitStatus:+ and exiting with $exitStatus}")
	    fi
	    printf -v filespecCommand 'cat %q%s' "$expandedFilespec" "; exit${exitStatus:+ }${exitStatus}"
	    export PS4='@ '
	    previousFilespec="$filespec"
	else
	    printfToSink '%s: Warning: Non-existing FILE given for %q; ignoring: %s\n' "$scriptName" "${debuggee}${module:+:}${module}" "$filespec"
	fi
    else
	printfToSink '%s: Warning: No FILE given for %q; ignoring.\n' "$scriptName" "${debuggee}${module:+:}${module}"
    fi
done
if [ -n "$filespecCommand" ]; then
    commands+="${commands:+; }${filespecCommand}"
fi

unset replacement
typeset -a substitutions=()
while debugConsumeDirectiveInto subst '/'
do
    if [ "$hasArgs" ] || [ $# -gt 0 ]; then
	isActive=t
	subst="${subst%/}"
	if [ -z "$subst" ]; then
	    printfToSink '%s: Warning: Empty PATTERN/REPLACEMENT given for %q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	elif [[ "$subst" = /* ]]; then
	    [ -n "${replacement+t}" ] \
		&& printfToSink '%s: Warning: Duplicate REPLACEMENTs given for %q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    replacement="${subst#/}"
	elif [[ "$subst" != */* ]]; then
	    [ -n "${replacement+t}" ] \
		&& printfToSink '%s: Warning: Duplicate REPLACEMENTs given for %q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    replacement="$subst"
	else
	    substitutions+=(-e "s/${subst}/g")
	fi
    fi
done
quotedArgs=; if [ $# -gt 0 ]; then printf -v quotedArgs '%q ' "$@"; quotedArgs="${quotedArgs% }"; fi
if [ -n "${replacement+t}" ]; then
    [ ${#substitutions[@]} -gt 0 ] \
	&& printfToSink '%s: Warning: PATTERN eclipsed by REPLACEMENT given for %q\n' "$scriptName" "${debuggee}${module:+:}${module}"
    [ -n "$quotedArgs" ] \
	&& actions+=("replacing arguments ${O}${quotedArgs}${C} with ${O}${replacement}${C}") \
	|| actions+=("injecting arguments ${O}${replacement}${C}")
    commands+="${commands:+; }set -- ${replacement}"
elif [ ${#substitutions[@]} -gt 0 ]; then
    quotedReplacement="$(printf '%s\n' "$quotedArgs" | sed "${substitutions[@]}")"
    if [ "$quotedArgs" = "$quotedReplacement" ]; then
	actions+=("no replacement of arguments ${O}${quotedArgs}${C}")
    elif [ -n "$quotedArgs" ]; then
	actions+=("replacing arguments ${O}${quotedArgs}${C} with ${O}${quotedReplacement}${C}")
    else
	actions+=("injecting arguments via replacement with ${O}${quotedReplacement}${C}")
    fi
    commands+="${commands:+; }set -- $quotedReplacement"
fi

isGloballyEnabledTracing=
typeset -A enabledTracePointNames=()
while debugConsumeDirectiveInto enabledTracePointName '&'; do
    [ -n "$enabledTracePointName" ] \
	&& enabledTracePointNames["$enabledTracePointName"]=t \
	|| isGloballyEnabledTracing=t
done
if [ "$isGloballyEnabledTracing" ] \
    || { [ -n "$tracePointName" ] && [ "${enabledTracePointNames["$tracePointName"]}" ]; }
then
    if [ ! "$isTracing" ]; then
	isActive=t
	actions+=("enabling tracing${tracePointName:+ at }${tracePointName}${toFile:+ to }${toFile}")
	postLogCommand=handleToFile
	commands+="${commands:+; }${traceRedir}; set -x"
    fi
elif [ -z "${isTracing+t}" ] || [ "$isTracing" ]; then
    isActive=t
    actions+=("disabling tracing${tracePointName:+ at }${tracePointName}")
    commands+="${commands:+; }set +x"
fi

unset previousExitStatus exitStatus
while debugConsumeDirectiveInto exitStatus '!'
do
    isActive=t
    [ -n "${previousExitStatus+t}" ] \
	&& printfToSink '%s: Warning: Duplicate !%s given for %q\n' "$scriptName" "$previousExitStatus" "${debuggee}${module:+:}${module}"
    previousExitStatus="$exitStatus"
done
if [ -n "${exitStatus+t}" ]; then
    export PS4='! '
    actions+=("exiting prematurely${exitStatus:+ with $exitStatus}")
    commands+="${commands:+; }exit${exitStatus:+ }${exitStatus}"
fi

case ",${DEBUG}," in
    *,"${debuggee}${module:+:}${module}",*)
	isActive=t
	;;
esac

if [ "$isActive" ]; then
    eval "$sinkRedir"
    logActions
    $postLogCommand
    [ -z "$commands" ] || printf '%s\n' "$commands"
else
    case ",${DEBUG}," in
	*,@(debug|${scriptName}),*)
	    quotedModule=; [ -n "$module" ] && printf -v quotedModule %q "$module"
	    printfToSink '%s: Will activate with DEBUG=%q%s%s\n' "$scriptName" "${debuggee}" '[![N]|&'"$tracePointName"'|=OTHER-COMMAND|@[N-]FILE|/[[PATTERN]/]REPLACEMENT/|?PREDICATE]' "${module:+:}${quotedModule}"
	    ;;
    esac
fi
