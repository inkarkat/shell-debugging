#!/bin/bash
shopt -qs extglob

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: ${DEBUG:+[env DEBUGCOMMAND_IFS=STRING|newline [DEBUG[COMMAND]_SINK=FILE|&N|"" | DEBUG_LOGDIR=DIR]] %q %s} %s\n' "$(basename "$1")" "[--for DEBUGGEE] [-m|--module MODULE] $(echotrace --get-short-usage general 2>/dev/null) $(verbose --get-short-usage general io debug-io 2>/dev/null) [--]" '[SIMPLECOMMAND ...]'
    printf 'Usage: ${DEBUG:+%q %s} %s\n' "$(basename "$1")" "[--for DEBUGGEE] [-m|--module MODULE] $(echotrace --get-short-usage general 2>/dev/null) $(verbose --get-short-usage general io debug-io 2>/dev/null) --eval [--]" 'eval [SIMPLECOMMAND ...]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
If debugging is not enabled for the caller, simply execute COMMAND.
When \$DEBUG refers plainly to the DEBUGGEE, COMMAND is executed and additionally
it's written as an execution trace.
When \$DEBUG refers to DEBUGGEE!, COMMAND is NOT executed and just written as an
execution trace.
Logging goes into a debug file (DEBUGGEE.log) / \$DEBUGCOMMAND_SINK /
\$DEBUG_SINK.
DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
With "DEBUG=debug[command]=FILE,DEBUGGEE[:MODULE] DEBUGGEE ..." will log to FILE
instead.
With "DEBUG=debug[command] DEBUGGEE ..." will show for what DEBUGGEE it will
enable (if not actually enabled).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
HELPTEXT
    echo 'echotrace options:'
    echotrace --get-long-usage io debug-io 2>/dev/null
    echo 'verbose options:'
    verbose --get-long-usage general io debug-io 2>/dev/null
    cat <<HELPTEXT
SEE ALSO:
- echotrace is used for the sole execution trace.
- verbose is used for the execution and execution trace.
- debugcustom only executes COMMAND(s) if debugging is enabled for the caller,
  but normally skips execution altogether.

EXIT STATUS:
    2	Bad invocation, wrong or missing command-line arguments.
    *	Any exit status from COMMAND(s).
HELPTEXT
}

debuggee="$DEBUG_DEBUGGEE"
module=
isEval=
typeset -a echotraceArgs=()
typeset -a verboseArgs=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--eval)		echotraceArgs+=("$1"); verboseArgs+=("$1"); shift; isEval=t;;
	--)		shift; break;;
	-*)		let understoodArgCount=0
			if argCount=$(echotrace --understand-for general --understand-for io --understand-for debug-io --understands "$@"); then
			    understoodArgCount=$argCount
			    echotraceArgs+=("${@:1:argCount}")
			elif [ $? -eq 2 ]; then
			    exit 2
			fi
			if argCount=$(verbose --understand-for general --understand-for io --understand-for debug-io --understands "$@"); then
			    understoodArgCount=$argCount
			    verboseArgs+=("${@:1:argCount}")
			elif [ $? -eq 2 ]; then
			    exit 2
			fi
			if [ $understoodArgCount -gt 0 ]; then
			    shift $understoodArgCount
			else
			    echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"
			    exit 2
			fi >&2
			;;
	*)		break;;
    esac
done
executor()
{
    [ "$1" = eval ] && EXEC=''
    $EXEC "$@"
}
if [ "$isEval" ] && [ "$1" = eval ]; then
    executor()
    {
	shift
	eval "$@"
    }
fi
if [ -z "$DEBUG" ]; then
    executor "$@"
    exit $?
fi

setSinkDefaults()
{
    case ",${DEBUG}," in
	*,@(debug|${scriptName})=*,*)
	    DEBUGCOMMAND_SINK=",${DEBUG},"; DEBUGCOMMAND_SINK="${DEBUGCOMMAND_SINK#*,@(debug|${scriptName})=}"; DEBUGCOMMAND_SINK="${DEBUGCOMMAND_SINK%%,*}"
	    ;;
    esac
}

setSinkAndExecute()
{
    setSinkDefaults

    if [ -n "${DEBUGCOMMAND_IFS+t}" ]; then
	export VERBOSE_IFS="$DEBUGCOMMAND_IFS"
	export ECHOTRACE_IFS="$DEBUGCOMMAND_IFS"
    fi
    local defaultLogDirspec="${DEBUG_LOGDIR-$PWD}"
    : ${DEBUG_SINK="${defaultLogDirspec}${defaultLogDirspec:+/}${debuggee//:/-}.log"}
    export VERBOSE_SINK="${DEBUGCOMMAND_SINK-$DEBUG_SINK}"
    export ECHOTRACE_SINK="${DEBUGCOMMAND_SINK-$DEBUG_SINK}"

    exec "${debugCommand[@]}" "${debugCommandArgs[@]}" -- "$@"
}

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
if [ -z "$debuggee" ]; then
    {
	IFS= read -r -d '' debugCmd
	IFS= read -r -d '' debugSecond
    } < /proc/${PPID}/cmdline
    debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
fi

typeset -a debugCommand=(verbose "${verboseArgs[@]}" --on-debug)
typeset -a debugCommandArgs=(--for "$debuggee" ${module:+--module "$module"})
case ",${DEBUG}," in
    *,"${debuggee}!${module:+:}${module}",*)
	;&
    *,"${debuggee}!":*,*)	# Also activate on any module so that echotrace's --io-modules|--stdin-module options will be considered. echotrace will do proper module filtering, anyway; it's just a bit more inefficient.
	debugCommand=(echotrace "${echotraceArgs[@]}")
	export ECHOTRACE_SIGIL='!'
	setSinkAndExecute "$@"
	;;
    *,"${debuggee}${module:+:}${module}",*)
	;&
    *,"${debuggee}":*,*)	# Also activate on any module so that verbose's --io-modules|--*-module options will be considered. verbose will do proper module filtering, anyway; it's just a bit more inefficient.
	setSinkAndExecute "$@"
	;;
    *,@(debug|${scriptName}|verbose),*)
	setSinkDefaults; sink="${DEBUGCOMMAND_SINK-$DEBUG_SINK}"
	case "$sink" in
	    '')		exec >&2;;
	    \&+([0-9]))	eval "exec >$sink";;
	    ?*)		exec >>"$sink";;
	esac
	printf '%s: Will log [and skip] command execution with DEBUG=%q[!]\n' "$scriptName" "${debuggee}${module:+:}${module}"
	exec "${debugCommand[@]}" "${debugCommandArgs[@]}" -- "$@"
	;;
esac
executor "$@"
