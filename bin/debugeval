#!/bin/bash
shopt -qs extglob

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: [DEBUG[EVAL]_SINK=FILESPEC|&N|""] %q %s\n' "$(basename "$1")" '[--for DEBUGGEE] [-m|--module MODULE] [--to FILE] [-?|-h|--help] ...'
    printf 'Usage: eval $(${DEBUG:+%q %s} "${DEBUG:-echo}" %s)\n' "$(basename "$1")" '... --' 'SIMPLECOMMAND [...]'
    printf 'Usage: eval $(${DEBUG:+%q %s} "${DEBUG:-echo}" %s)\n' "$(basename "$1")" '... -c|--command' '"COMMANDLINE"'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
If debugging is not enabled for the caller, simply print COMMAND so that the
invoking eval executes it normally.
When \$DEBUG refers plainly to the DEBUGGEE, COMMAND is printed for execution by
the invoking eval and additionally written as an execution trace.
When \$DEBUG refers to DEBUGGEE!, COMMAND is NOT printed / executed and just
written as an execution trace.
When \$DEBUG refers to DEBUGGEE&, COMMAND is printed for execution with tracing
enabled (set -x) by the invoking eval and additionally written as an execution
trace.
When \$DEBUG refers to DEBUGGEE=OTHER-COMMAND, OTHER-COMMAND instead of COMMAND
is printed for execution by the invoking eval and additionally written as an
execution trace.
When \$DEBUG refers to DEBUGGEE^=PREFIX, PREFIX is put before COMMAND for
execution by the invoking eval and additionally written as an execution trace.
When \$DEBUG refers to DEBUGGEE+=SUFFIX, SUFFIX is put after COMMAND for
execution by the invoking eval and additionally written as an execution trace.
Logging goes into a debug file (DEBUGGEE.log) / \$DEBUGEVAL_SINK / \$DEBUG_SINK.
DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
With "DEBUG=debug[eval]=FILESPEC,DEBUGGEE[:MODULE] DEBUGGEE ..." will log to
FILESPEC instead.
With "DEBUG=debug[eval] DEBUGGEE ..." will show for what DEBUGGEE it will
enable (if not actually enabled).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
    --to FILE		Use FILE instead of the default debug file
			DEBUGGEE.log (unless overridden).
SEE ALSO:
- debugcustom can directly (i.e. without eval) execute COMMAND(s) if debugging
  is enabled for the caller, and will log them. Prefer if COMMAND(s) can be
  invoked by an external script.
- debugenabled can be used to check whether debugging is enabled or query the
  sink; prefer for the conditional execution of traps or script-local
  functionality if you don't need the additional embellishments provided by
  debugeval.
HELPTEXT
}

assertSingleCommand()
{
    [ -z "$commands" ] || { printf 'ERROR: COMMAND is allowed only once, but given "%s" and "%s" (minus "%s").\n' "$commands" "$1" "$DEBUG" >&2; exit 2; }
}

debuggee="$DEBUG_DEBUGGEE"
module=
commands=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--to)		shift; DEBUGEVAL_SINK="${1:?}"; shift;;
	--command|-c)	shift
			assertSingleCommand "$*"
			[ -n "$DEBUG" -a "$1" = "$DEBUG" ] && shift   # The ${DEBUG:-echo} non-debug fallback.
			commands="$1"; shift
			;;
	--)		shift
			[ -n "$DEBUG" -a "$1" = "$DEBUG" ] && shift   # The ${DEBUG:-echo} non-debug fallback.
			break
			;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 0 ]; then
    assertSingleCommand "$*"
    # Need to quote SIMPLECOMMAND to undo the effects of eval.
    printf -v quotedSimpleCommand '%q ' "$@"
    commands="${quotedSimpleCommand% }"
fi
if [ -z "$commands" ]; then
    echo "ERROR: No COMMAND(s) specified; need to pass -c|--command \"COMMANDLINE\", or SIMPLECOMMAND."
    echo
    printUsage "$0"
    exit 2
fi >&2

beforeCommands=
afterCommands=
passthroughCommands()
{
    printf %s%s%s "${beforeCommands}${beforeCommands:+; }" "$commands" "${afterCommands:+; }${afterCommands}"
}

if [ -z "$DEBUG" ]; then
    passthroughCommands
    exit 0
fi

traceRedir=
setSinkDefaults()
{
    case ",${DEBUG:-}," in
	*,@(debug|${scriptName})=*,*) DEBUGEVAL_SINK=",${DEBUG},"; DEBUGEVAL_SINK="${DEBUGEVAL_SINK#*,@(debug|${scriptName})=}"; DEBUGEVAL_SINK="${DEBUGEVAL_SINK%%,*}"
	    ;;
	*)  : ${DEBUG_SINK:="${PWD}/${debuggee//:/-}.log"};;
    esac

    local sink="${DEBUGEVAL_SINK-$DEBUG_SINK}"
    local sinkRedir
    case "$sink" in
	'')		sinkRedir='exec 3>&2'; traceRedir='BASH_XTRACEFD=2';;
	\&+([0-9]))	sinkRedir="exec 3>$sink"; traceRedir="${sinkRedir}; BASH_XTRACEFD=3";;
	?*)		printf -v sinkRedir 'exec 3>>%q' "$sink"; traceRedir="${sinkRedir}; BASH_XTRACEFD=3";;
    esac
    eval "$sinkRedir"
}

logCommands()
{
    local timestampPrefix="$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging})"
    local nestingPrefix="$(debugNestingPrefix)"
    local printerPrefix="${timestampPrefix}${timestampPrefix:+ }${nestingPrefix}"
    printf >&3 '%s%s %s\n' "$printerPrefix" "$debuggee (${module}${module:+, }${PPID})" "$commands"
}

passthroughAndLogCommands()
{
    logCommands
    passthroughCommands
}

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
if [ -z "$debuggee" ]; then
    {
	IFS= read -r -d '' debugCmd
	IFS= read -r -d '' debugSecond
    } < /proc/${PPID}/cmdline
    debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
fi

action=passthroughCommands
case ",${DEBUG:-}," in
    *,${debuggee}!${module:+:}${module},*)
	setSinkDefaults
	action=logCommands
	;;
    *,${debuggee}\&${module:+:}${module},*)
	setSinkDefaults
	beforeCommands="${traceRedir}; set -x"
	afterCommands='set +x'
	action=passthroughAndLogCommands
	;;
    *,${debuggee}=+([^:,])${module:+:}${module},*)
	setSinkDefaults
	commands=",${DEBUG},"; commands="${commands#*,${debuggee}=}"; commands="${commands%%${module:+:}${module},*}"
	action=passthroughAndLogCommands
	;;
    *,${debuggee}^=+([^:,])${module:+:}${module},*)
	setSinkDefaults
	prefix=",${DEBUG},"; prefix="${prefix#*,${debuggee}^=}"; prefix="${prefix%%${module:+:}${module},*}"
	commands="${prefix}${commands}"
	action=passthroughAndLogCommands
	;;
    *,${debuggee}+=+([^:,])${module:+:}${module},*)
	setSinkDefaults
	suffix=",${DEBUG},"; suffix="${suffix#*,${debuggee}+=}"; suffix="${suffix%%${module:+:}${module},*}"
	commands+="$suffix"
	action=passthroughAndLogCommands
	;;
    *,${debuggee}${module:+:}${module},*)
	setSinkDefaults
	action=passthroughAndLogCommands
	;;
    *,@(debug|${scriptName}),*)
	{ printf >/dev/tty '%s: Will activate with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"; } 2>/dev/null
	;;
esac

$action
