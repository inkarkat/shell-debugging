#!/bin/bash
shopt -qs extglob

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }
readonly projectDir="${scriptDir}/.."
readonly libDir="${projectDir}/lib"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: [DEBUG[EVAL]_SINK=FILE|&N|"" | DEBUG_LOGDIR=DIR] %q %s\n' "$(basename "$1")" '[--for DEBUGGEE] [-m|--module MODULE] [--piped] [--to FILE] [-?|-h|--help] ...'
    printf 'Usage: eval $(${DEBUG:+%q %s} "${DEBUG:-echo}" %s)\n' "$(basename "$1")" '... --' 'SIMPLECOMMAND [...]'
    printf 'Usage: eval $(${DEBUG:+%q %s} "${DEBUG:-echo}" %s)\n' "$(basename "$1")" '... -c|--command' '"COMMANDLINE"'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
If debugging is not enabled for the caller, simply print COMMAND so that the
invoking eval executes it normally.
When \$DEBUG refers plainly to the DEBUGGEE, COMMAND is printed for execution by
the invoking eval and additionally written as an execution trace.
\$ DEBUG=DEBUGGEE[:MODULE][EXTENSION] DEBUGGEE ...

Extensions:
When \$DEBUG refers to DEBUGGEE!, COMMAND is NOT printed / executed and just
written as an execution trace.
When \$DEBUG refers to DEBUGGEE&, COMMAND is printed for execution with tracing
enabled (set -x) by the invoking eval and additionally written as an execution
trace.
When \$DEBUG refers to DEBUGGEE~, COMMAND is printed for execution with time
reporting (to the debug file) enabled by the invoking eval and additionally
written as an execution trace.
When \$DEBUG refers to DEBUGGEE=OTHER-COMMAND, OTHER-COMMAND instead of COMMAND
is printed for execution by the invoking eval and additionally written as an
execution trace.
When \$DEBUG refers to DEBUGGEE@[N-]FILE, the execution uses the contents of
FILE (and an exit status of N) as the output of the skipped COMMAND execution.
This allows the injection of canned output (and exit status) for testing
purposes.
When \$DEBUG refers to DEBUGGEE^=PREFIX, PREFIX is put before COMMAND for
execution by the invoking eval and additionally written as an execution trace.
When \$DEBUG refers to DEBUGGEE+=SUFFIX, SUFFIX is put after COMMAND for
execution by the invoking eval and additionally written as an execution trace.
When \$DEBUG refers to DEBUGGEE?PREDICATE, COMMAND is printed for execution by
the invoking eval (or not printed / replaced / embellished according to any
other instructions) and also written as an execution trace only if PREDICATE is
successful.

Logging goes into a debug file (DEBUGGEE.log) / \$DEBUGEVAL_SINK / \$DEBUG_SINK.
\$ DEBUG=debug[eval]=FILE,DEBUGGEE[:MODULE][EXTENSION] DEBUGGEE ... will log to
  FILE instead.
\$ DEBUG=debug[eval] DEBUGGEE ... will show for what DEBUGGEE it will enable (if
  not actually enabled).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
    --piped		Indicate that the COMMAND is part of a pipeline.
			Multiple OTHER-COMMANDs are joined with "|" instead of
			";" then.
    --to FILE		Use FILE instead of the default debug file DEBUGGEE.log
			for printing the execution trace, command tracing and
			time reporting and just leave a reference to FILE there.
SEE ALSO:
- debugcustom can directly (i.e. without eval) execute COMMAND(s) if debugging
  is enabled for the caller, and will log them. Prefer if COMMAND(s) can be
  invoked by an external script.
- debugenabled can be used to check whether debugging is enabled or query the
  sink; prefer for the conditional execution of traps or script-local
  functionality if you don't need the additional embellishments provided by
  debugeval.
- testeval is a variant that triggers on TEST instead of DEBUG and does not
  write execution traces nor supports trace enablement, and is intended for
  implementing test hooks.
HELPTEXT
}

assertSingleCommand()
{
    [ -z "$commands" ] || { printf 'ERROR: COMMAND is allowed only once, but given "%s" and "%s" (minus "%s").\n' "$commands" "$1" "$DEBUG" >&2; exit 2; }
}

debuggee="$DEBUG_DEBUGGEE"
module=
toFile=
commands=
commandJoiner=';'
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--piped)	shift; commandJoiner='|';;
	--to)		shift; toFile="${1:?}"; shift;;
	--command|-c)	shift
			assertSingleCommand "$*"
			[ -n "$DEBUG" -a "$1" = "$DEBUG" ] && shift   # The ${DEBUG:-echo} non-debug fallback.
			commands="$1"; shift
			;;
	--)		shift
			[ -n "$DEBUG" -a "$1" = "$DEBUG" ] && shift   # The ${DEBUG:-echo} non-debug fallback.
			break
			;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 0 ]; then
    assertSingleCommand "$*"
    # Need to quote SIMPLECOMMAND to undo the effects of eval.
    printf -v quotedSimpleCommand '%q ' "$@"
    commands="${quotedSimpleCommand% }"
fi
if [ -z "$commands" ]; then
    echo "ERROR: No COMMAND(s) specified; need to pass -c|--command \"COMMANDLINE\", or SIMPLECOMMAND."
    echo
    printUsage "$0"
    exit 2
fi >&2

silentCommandPrefix=
silentCommandSuffix=
passthroughCommands()
{
    printf %s%s%s "$silentCommandPrefix" "$commands" "$silentCommandSuffix"
}

if [ -z "$DEBUG" ]; then
    passthroughCommands
    exit 0
fi

source "${libDir}/directiveParser.sh" || exit 3

printfToSink()
{
    eval "printf \"\$@\" $redir"
}

logCommands()
{
    local timestampPrefix="$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging})"
    local nestingPrefix="$(debugNestingPrefix)"
    local printerPrefix="${timestampPrefix}${timestampPrefix:+ }${nestingPrefix}"
    printf >&3 '%s%s %s\n' "$printerPrefix" "$debuggee (${module}${module:+, }${PPID})" "$commands"
}

passthroughAndLogCommands()
{
    logCommands
    passthroughCommands
}

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
if [ -z "$debuggee" ]; then
    {
	IFS= read -r -d '' debugCmd
	IFS= read -r -d '' debugSecond
    } < /proc/${PPID}/cmdline
    debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
fi

case ",${DEBUG}," in
    *,@(debug|${scriptName})=*,*) DEBUGEVAL_SINK=",${DEBUG},"; DEBUGEVAL_SINK="${DEBUGEVAL_SINK#*,@(debug|${scriptName})=}"; DEBUGEVAL_SINK="${DEBUGEVAL_SINK%%,*}"
	;;
    *)  defaultLogDirspec="${DEBUG_LOGDIR-$PWD}"
	: ${DEBUG_SINK="${defaultLogDirspec}${defaultLogDirspec:+/}${debuggee//:/-}.log"}
	;;
esac

sink="${DEBUGEVAL_SINK-$DEBUG_SINK}"
redir=
sinkRedir=
traceRedir=
case "$sink" in
    '')		redir='>&2'
		sinkRedir="exec 3${redir}"
		traceRedir='BASH_XTRACEFD=2'
		;;
    \&+([0-9]))	redir=">$sink"
		sinkRedir="exec 3${redir}"
		traceRedir="${sinkRedir}; BASH_XTRACEFD=3"
		;;
    ?*)		printf -v redir '>>%q' "$sink"
		sinkRedir="exec 3${redir}"
		traceRedir="${sinkRedir}; BASH_XTRACEFD=3"
		;;
esac
handleToFile()
{
    [ -n "$toFile" ] || return 0

    # Log the reference in the debug file.
    timestampPrefix="$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging})"
    (eval "$sinkRedir"; printf >&3 '%s%s Logged to %s\n' "${timestampPrefix}${timestampPrefix:+ }" "$debuggee (${module}${module:+, }${PPID})" "$toFile")

    # Redirect the captured output to the specified FILE.
    printf -v redir '>>%q' "$toFile"
    sinkRedir="exec 3${redir}"
    traceRedir="${sinkRedir}; BASH_XTRACEFD=3"

    toFile=''	# No-op if the function is called again.
}

isActive=
action=

hadPredicate=; while debugConsumeDirectiveInto predicate '?'; do
    hadPredicate=t
    if [ -z "$predicate" ]; then
	isActive=t
	printfToSink '%s: Warning: Empty PREDICATE given for %q\n' "$scriptName" "${debuggee}${module:+:}${module}"
    elif eval "(${sinkRedir}; { ${predicate}; } >&3 2>&3)"; then
	isActive=t
    fi
done
if [ "$hadPredicate" ] && [ ! "$isActive" ]; then
    passthroughCommands
    exit 0
fi

case ",${DEBUG}," in
    *,"${debuggee}${module:+:}${module}",*)
	isActive=t
	;;
    *,"${debuggee}${module:+:}${module}!",*)
	isActive=t
	export PS4='! '
	action=logCommands
	;;
    *,"${debuggee}${module:+:}${module}&",*)
	isActive=t
	handleToFile
	silentCommandPrefix="${traceRedir}; set -x; "
	silentCommandSuffix='; set +x'
	;;
    *,"${debuggee}${module:+:}${module}~",*)
	isActive=t
	handleToFile
	silentCommandPrefix='{ TIMEFORMAT="real %3lR, user %3lU, sys %3lS"; time '
	silentCommandSuffix="; } 2$redir"
	;;
    *)
	hasOtherCommand=
	while debugConsumeDirectiveInto otherCommand '='; do
	    isActive=t
	    if [ -z "$otherCommand" ]; then
		printfToSink '%s: Warning: Empty OTHER-COMMAND given for %q (better use DEBUGGEE!)\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    else
		[ "$hasOtherCommand" ] || commands=''
		commands+="${commands:+$commandJoiner }${otherCommand}"
		hasOtherCommand=t
		export PS4='= '
	    fi
	done

	previousFilespec=
	while debugConsumeDirectiveInto filespec '@'; do
	    isActive=t

	    eval "expandedFilespec=$filespec" # Expand environment variables and tilde.
	    if [ -n "$expandedFilespec" ]; then
		exitStatus=
		if [[ "$expandedFilespec" =~ ^(.*/)?([0-9]+)-(.+)$ ]]; then
		    exitStatus="${BASH_REMATCH[2]}"
		    expandedFilespec="${BASH_REMATCH[1]}${BASH_REMATCH[3]}"
		fi
		if [ -e "$expandedFilespec" ]; then
		    isActive=t
		    if [ -n "$previousFilespec" ]; then
			printfToSink '%s: Warning: Duplicate @%s given for %q\n' "$scriptName" "$previousFilespec" "${debuggee}${module:+:}${module}"
			actions[-1]="outputting ${expandedFilespec}${exitStatus:+ and exiting with $exitStatus}"
		    else
			actions+=("outputting ${expandedFilespec}${exitStatus:+ and exiting with $exitStatus}")
		    fi
		    printf -v commands 'cat %q%s' "$expandedFilespec" "; exit${exitStatus:+ }${exitStatus}"
		    export PS4='@ '
		    previousFilespec="$filespec"
		else
		    printfToSink '%s: Warning: Non-existing FILE given for %q; ignoring: %s\n' "$scriptName" "${debuggee}${module:+:}${module}" "$filespec"
		fi
	    else
		printfToSink '%s: Warning: No FILE given for %q; ignoring.\n' "$scriptName" "${debuggee}${module:+:}${module}"
	    fi
	done
	;;
esac

# We can only embellish the COMMAND if it's still to be executed (i.e.
# not disabled by the ! case).
if [ -z "$action" ]; then
    while debugConsumeDirectiveInto prefix '^='
    do
	isActive=t
	commands="${prefix}${commands}"
	[ -z "$prefix" ] && printfToSink '%s: Warning: Empty PREFIX given for %q\n' "$scriptName" "${debuggee}${module:+:}${module}"
    done
    while debugConsumeDirectiveInto suffix '+='
    do
	isActive=t
	commands+="$suffix"
	[ -z "$suffix" ] && printfToSink '%s: Warning: Empty SUFFIX given for %q\n' "$scriptName" "${debuggee}${module:+:}${module}"
    done
fi

if [ "$isActive" ]; then
    handleToFile
    eval "$sinkRedir"
    ${action:-passthroughAndLogCommands}
else
    case ",${DEBUG}," in
	*,@(debug|${scriptName}),*)
	    quotedModule=; [ -n "$module" ] && printf -v quotedModule %q "$module"
	    printfToSink '%s: Will activate with DEBUG=%q%s%s\n' "$scriptName" "${debuggee}" "${module:+:}${quotedModule}" '[!|&|~|=OTHER-COMMAND|@[N-]FILE|^=PREFIX|+=SUFFIX|?PREDICATE]'
	    ;;
    esac

    passthroughCommands
fi
