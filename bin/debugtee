#!/bin/bash
shopt -qs extglob

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: cat FILE [...] | [DEBUG[TEE]_SINK=FILE|&N|"" | DEBUG_LOGDIR=DIR] %q %s | COMMAND ...\n' "$(basename "$1")" '[-1|--single-capture] [--no-header|-d|--description DESCRIPTION] [--for DEBUGGEE] [-m|--module MODULE] [--to FILE]'
    printf "Usage: cat FILE [...] | eval \"\${DEBUG:+%q %s |}\" 'COMMAND [...]'\\n" "$(basename "$1")" '...'
    printf "Usage: eval 'COMMAND [...]' \"\${DEBUG:+| %q %s}\"\\n" "$(basename "$1")" '... [--to ${HOME@Q}/out.log}]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Duplicate standard input to \$DEBUGTEE_SINK / \$DEBUG_SINK / a debug file
DEBUGGEE.log inside \$DEBUG_LOGDIR / the current directory if debugging is
enabled for the debuggee, and print the debug filespec to the terminal at the
end:
$ DEBUG=DEBUGGEE[:MODULE] DEBUGGEE ...
$ DEBUG=debug[tee]=FILE|&N,DEBUGGEE[:MODULE] DEBUGGEE ... will log to a custom
  FILE or file descriptor N instead.
$ DEBUG=debug[tee] DEBUGGEE ... will show for what DEBUGGEE it will enable (if
  not actually enabled).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --single-capture|-1	Don't append to the debug file, but overwrite it with
			the latest capture. Disables the header, too.
    --no-header		Omit the header line with the timestamp (which is added
			by default).
    --description|-d DESCRIPTION
			Prepend DESCRIPTION to the timestamp in the header line.
    --for DEBUGGEE	Target DEBUGGEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if debugging for MODULE of the DEBUGGEE is
			enabled.
    --to FILE		Use FILE instead of the default debug file DEBUGGEE.log
			and just leave a reference to FILE there.
SEE ALSO:
- dump-files [--on-debug] prints file contents, not pipelined standard input to
  a debug file.
- verbose --on-debug --stdin|--stdout|--stderr logs what gets into / out of an
  invoked COMMAND, not with header, not into separate files, but with prefixes
  to distinguish the streams.
HELPTEXT
}

debuggee="$DEBUG_DEBUGGEE"
module=
toFile=
isAppend=t
isHeader=t
description=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--single-capture|-1)
			shift; isAppend=;;
	--no-header)	shift; isHeader=;;
	--description|-d)
			shift; description="${1?}"; shift;;
	--for)		shift; debuggee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--to)		shift; toFile="${1:?}"; shift;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 0 ]; then
    printUsage "$0" >&2
    exit 2
fi
[ ! "$isAppend" ] && [ -z "$description" ] && isHeader=	# Disable header if not appending and no description is given.

[ -n "$DEBUG" ] || exec cat

finally()
{
    if [ -n "$toFile" -a ! -s "$sink" -a -e "$sink" ]; then
	# Clean up an empty debug log explicitly set via --to FILE.
	rm --force -- "$sink" || :
    fi
}

printfToSink()
{
    case "$sink" in
	'')		[ -n "$BATS_TEST_NAME" ] \
			    && printf "$@" >&3 \
			    || printf "$@" >&2
			;;
	\&+([0-9]))	eval "printf \"\$@\" >$sink";;
	?*)		printf "$@" >>"$sink";;
    esac
}

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
if [ -z "$debuggee" ]; then
    {
	IFS= read -r -d '' debugCmd
	IFS= read -r -d '' debugSecond
    } < /proc/${PPID}/cmdline
    debuggee="$(commandName --no-interpreter --undefined "$scriptName" -- "$debugCmd" "$debugSecond")"
fi

case ",${DEBUG}," in
    *,"${debuggee}${module:+:}${module}",*)
	case ",${DEBUG}," in
	    *,@(debug|${scriptName})=*,*) filespec=",${DEBUG},"; filespec="${filespec#*,@(debug|${scriptName})=}"; filespec="${filespec%%,*}"
		DEBUGTEE_SINK="$(realpath --no-symlinks -- "$filespec")" || DEBUGTEE_SINK="$filespec"
		;;
	    *)	defaultLogDirspec="${DEBUG_LOGDIR-$PWD}"
		: ${DEBUG_SINK="${defaultLogDirspec}${defaultLogDirspec:+/}${debuggee//:/-}.log"}
		;;
	esac

	sink="${DEBUGTEE_SINK-$DEBUG_SINK}"
	if [ -n "$toFile" ]; then
	    # Log the reference in the debug file.
	    timestampPrefix="$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging})"
	    printfToSink '%s%s Logged to %s\n' "${timestampPrefix}${timestampPrefix:+ }" "$debuggee (${module}${module:+, }${PPID})" "$toFile"

	    # Redirect the captured output to the specified FILE.
	    sink="$toFile"
	fi
	case "$sink" in
	    '')		sink=/dev/stderr;;
	    \&+([0-9]))	sink="/dev/fd/${sink#\&}";;
	    ?*)		trap finally EXIT;;
	esac

	if [ "$isHeader" ]; then
	    isFirst=; [ ! "$isAppend" ] || [ ! -s "$sink" ] && isFirst=t;
	    eval 'HEADER_STYLE=dashed-line header ${isFirst:+--first} --no-color -- "${description}${description:+ at }$(${DEBUG_TIMESTAMP_COMMAND-timestamp --logging})"' ">${isAppend:+>} \"$sink\""
	    isAppend=t
	fi
	tee ${isAppend:+--append} -- "$sink"
	;;
    *,@(debug|${scriptName}),*)
	printfToSink '%s: Will activate with DEBUG=%q\n' "$scriptName" "${debuggee}${module:+:}${module}"
	;&
    *)	exec cat
esac
