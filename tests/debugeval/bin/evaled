#!/bin/bash

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }

if [ "$USE_COMMANDLINE" ]; then
    eval "$(${DEBUG:+debugeval --command} "${DEBUG:-echo}" ". ${scriptDir@Q}/scriptlet.sh lulli")"
else
    eval "$(${DEBUG:+debugeval --} "${DEBUG:-printf}" "${DEBUG:- %q}" . "$scriptDir/scriptlet.sh" lulli)"
fi && foo
